---
import { siteConfig } from "@site/config";

const prompt = siteConfig.askAiPrompt || "";
const encoded = encodeURIComponent(prompt);
---

<style>
  .ask-ai-section {
    margin: 48px 0;
    padding: 32px 0;
    border-top: 1px solid var(--border, #e5e5e5);
  }

  .ask-ai-header {
    text-align: center;
    margin-bottom: 24px;
  }

  .ask-ai-header h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 6px;
    color: var(--txt-p, #1a1a1a);
  }

  .ask-ai-header p {
    font-size: 0.875rem;
    color: var(--txt-s, #666);
    margin: 0;
  }

  .ask-ai-grid {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .ask-ai-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    color: #1a1a1a;
    background: #fff;
    border: 1px solid var(--border, #e5e5e5);
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .ask-ai-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  }

  .ask-ai-btn:focus-visible {
    outline: 2px solid #4a90d9;
    outline-offset: 2px;
  }

  .ask-ai-btn svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  /* Platform accent colors on hover */
  .ask-ai-btn[data-ai-platform="chatgpt"]:hover {
    border-color: #10a37f;
    color: #10a37f;
  }
  .ask-ai-btn[data-ai-platform="claude"]:hover {
    border-color: #d97706;
    color: #d97706;
  }
  .ask-ai-btn[data-ai-platform="perplexity"]:hover {
    border-color: #20b2aa;
    color: #20b2aa;
  }

  /* Dark mode */
  @media (prefers-color-scheme: dark) {
    .ask-ai-section {
      border-top-color: var(--darkmode-border, #333);
    }
    .ask-ai-header h3 {
      color: var(--darkmode-txt-p, #f0f0f0);
    }
    .ask-ai-header p {
      color: var(--darkmode-txt-s, #999);
    }
    .ask-ai-btn {
      background: var(--darkmode-bg-s, #1a1a1a);
      border-color: var(--darkmode-border, #333);
      color: var(--darkmode-txt-p, #f0f0f0);
    }
    .ask-ai-btn:hover {
      box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    }
  }

  /* Mobile */
  @media (max-width: 640px) {
    .ask-ai-grid {
      flex-direction: column;
      align-items: stretch;
    }
    .ask-ai-btn {
      justify-content: center;
    }
  }
</style>

{prompt && (
<section class="ask-ai-section" aria-label={`Ask AI about ${siteConfig.name}`}>
  <div class="ask-ai-header">
    <h3>Not sure yet?</h3>
    <p>Ask an AI for a second opinion on which hot springs fit your trip.</p>
  </div>
  <div class="ask-ai-grid">
    <a
      href={`https://chatgpt.com/?q=${encoded}`}
      class="ask-ai-btn"
      data-ai-platform="chatgpt"
      aria-label={`Ask ChatGPT about ${siteConfig.name}`}
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22.282 9.821a5.985 5.985 0 0 0-.516-4.91 6.046 6.046 0 0 0-6.51-2.9A6.065 6.065 0 0 0 4.981 4.18a5.985 5.985 0 0 0-3.998 2.9 6.046 6.046 0 0 0 .743 7.097 5.98 5.98 0 0 0 .51 4.911 6.051 6.051 0 0 0 6.515 2.9A5.985 5.985 0 0 0 13.26 24a6.056 6.056 0 0 0 5.772-4.206 5.99 5.99 0 0 0 3.997-2.9 6.056 6.056 0 0 0-.747-7.073zM13.26 22.43a4.476 4.476 0 0 1-2.876-1.04l.141-.081 4.779-2.758a.795.795 0 0 0 .392-.681v-6.737l2.02 1.168a.071.071 0 0 1 .038.052v5.583a4.504 4.504 0 0 1-4.494 4.494zM3.6 18.304a4.47 4.47 0 0 1-.535-3.014l.142.085 4.783 2.759a.771.771 0 0 0 .78 0l5.843-3.369v2.332a.08.08 0 0 1-.033.062L9.74 19.95a4.5 4.5 0 0 1-6.14-1.646zM2.34 7.896a4.485 4.485 0 0 1 2.366-1.973V11.6a.766.766 0 0 0 .388.676l5.815 3.355-2.02 1.168a.076.076 0 0 1-.071 0l-4.83-2.786A4.504 4.504 0 0 1 2.34 7.872zm16.597 3.855l-5.833-3.387L15.119 7.2a.076.076 0 0 1 .071 0l4.83 2.791a4.494 4.494 0 0 1-.676 8.105v-5.678a.79.79 0 0 0-.407-.667zm2.01-3.023l-.141-.085-4.774-2.782a.776.776 0 0 0-.785 0L9.409 9.23V6.897a.066.066 0 0 1 .028-.061l4.83-2.787a4.5 4.5 0 0 1 6.68 4.66zm-12.64 4.135l-2.02-1.164a.08.08 0 0 1-.038-.057V6.075a4.5 4.5 0 0 1 7.375-3.453l-.142.08L8.704 5.46a.795.795 0 0 0-.393.681zm1.097-2.365l2.602-1.5 2.607 1.5v2.999l-2.597 1.5-2.607-1.5z"/></svg>
      ChatGPT
    </a>
    <a
      href={`https://claude.ai/new?q=${encoded}`}
      class="ask-ai-btn"
      data-ai-platform="claude"
      aria-label={`Ask Claude about ${siteConfig.name}`}
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M4.709 15.955l4.72-2.756.08-.046 2.803-1.636a.206.206 0 0 0 0-.357l-2.956-1.726-4.716-2.752a.206.206 0 0 0-.309.178v8.917a.206.206 0 0 0 .309.178h.069zm7.582-4.552l2.819 1.645 4.716 2.753a.206.206 0 0 0 .309-.179V6.642a.206.206 0 0 0-.309-.178l-4.72 2.756-2.815 1.643a.206.206 0 0 0 0 .357v.003l-.003-.001zm-.073 1.052v3.494c0 .121.13.199.237.137l5.862-3.422a.206.206 0 0 0 0-.357l-5.858-3.42a.206.206 0 0 0-.31.179v3.494c0 .082.044.158.113.199l.159-.053z"/></svg>
      Claude
    </a>
    <a
      href={`https://www.perplexity.ai/?q=${encoded}`}
      class="ask-ai-btn"
      data-ai-platform="perplexity"
      aria-label={`Ask Perplexity about ${siteConfig.name}`}
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm0 18c-4.411 0-8-3.589-8-8s3.589-8 8-8 8 3.589 8 8-3.589 8-8 8zm-2-11a2 2 0 1 1 4 0 2 2 0 0 1-4 0zm-2.5 6.5a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0zm9-3a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z"/></svg>
      Perplexity
    </a>
  </div>
</section>
)}
