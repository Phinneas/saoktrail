---
import Social from "@components/common/Social.astro";
import { siteConfig } from "@site/config";
import { getAuthorByline, getAuthor } from "@lib/schema";

const author = getAuthor();
---

<footer class="glass container lg:my-4 lg:rounded-lg intersect:animate-fadeUp opacity-0">
  <div class="row py-2 lg:py-0 items-center flex-wrap-reverse">
    <div class="text-center lg:col-6 lg:mb-0 lg:text-left">
      <ul>
        <li class="m-2 inline-block">
          <a href="/">&copy; {siteConfig.name} 2025</a>
        </li>
        <li class="m-2 inline-block">
          <a href="/about">About</a>
        </li>
        <li class="m-2 inline-block">
          <a href="/about#disclosure">Disclosure</a>
        </li>
      </ul>
      <p class="text-xs text-txt-s dark:text-darkmode-txt-s mt-2">
        City data from <a href="https://simplemaps.com/data/us-cities" target="_blank" rel="noopener noreferrer" class="underline hover:text-accent">SimpleMaps</a> (CC BY 4.0).
        Hot spring data from <a href="https://www.openstreetmap.org/" target="_blank" rel="noopener noreferrer" class="underline hover:text-accent">OpenStreetMap</a> (ODbL).
        Images from <a href="https://commons.wikimedia.org/" target="_blank" rel="noopener noreferrer" class="underline hover:text-accent">Wikimedia Commons</a>.
      </p>
      <p class="text-xs text-txt-s dark:text-darkmode-txt-s mt-1">
        Researched &amp; maintained by <a href={author.url} class="underline hover:text-accent">{author.name}</a>
      </p>
    </div>
    <div class="text-center lg:col-6 lg:my-0 flex items-center justify-center lg:justify-end">
      <Social
        links={siteConfig.social}
        shares={siteConfig.shares}
      />
    </div>
  </div>
</footer>
