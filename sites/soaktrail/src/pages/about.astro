---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Chester Beard',
  url: 'https://soaktrail.com/about',
  description: 'Conservation photographer and outdoors explorer documenting natural hot springs across the American West. Former Washington State Executive Council member of the Sierra Club and photographer for The Nature Conservancy.',
  jobTitle: 'Conservation Photographer & Researcher',
  worksFor: {
    '@type': 'Organization',
    name: 'Soak Trail',
    url: 'https://soaktrail.com',
  },
  affiliation: [
    {
      '@type': 'Organization',
      name: 'Sierra Club',
      description: 'Washington State Executive Council',
    },
    {
      '@type': 'Organization',
      name: 'The Nature Conservancy',
      description: 'Photographer',
    },
  ],
  sameAs: [
    'https://www.instagram.com/soaktrail',
    'https://bsky.app/profile/soaktrail.bsky.social',
    'https://www.pinterest.com/soaktrail',
  ],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://soaktrail.com/' },
    { '@type': 'ListItem', position: 2, name: 'About', item: 'https://soaktrail.com/about' },
  ],
};
---

<BaseLayout
  title="About — Soak Trail"
  description="Meet Chester Beard — conservation photographer, Sierra Club leader, and the researcher behind Soak Trail's hot springs field guides and data."
  ogType="profile"
  jsonLd={[personSchema, breadcrumbSchema]}
>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="container mx-auto px-4 py-12 max-w-3xl">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'About', href: '/about' },
    ]} />

    <h1 class="font-display text-4xl font-bold text-sa-dark mt-8 mb-2">About Soak Trail</h1>
    <p class="text-sa-copper font-display text-lg mb-8">Researched &amp; maintained by Chester Beard</p>

    <div class="prose prose-lg max-w-none">
      <p class="text-lg text-sa-dark/80 leading-relaxed">
        Soak Trail is an independent research project documenting natural hot springs
        across the American West. It grew from years of road trips through the region's
        back roads and mountain passes — stopping at hot springs along the way and
        noticing how hard it was to find reliable, current information about where to soak.
      </p>

      <h2 class="font-display text-2xl font-bold text-sa-dark mt-10 mb-4">The Researcher</h2>
      <p class="text-sa-dark/80 leading-relaxed">
        Chester Beard is a conservation photographer and outdoors explorer based in the
        Pacific Northwest. He has worked as a photographer for The Nature Conservancy
        and served on the Washington State Executive Council of the Sierra Club. That
        background in conservation and field work shaped Soak Trail's approach: combine
        public data sources with field verification to produce accurate, accessible guides
        for natural hot springs.
      </p>
      <p class="text-sa-dark/80 leading-relaxed mt-4">
        Years of road trips through the western US — from Idaho's backcountry to Oregon's
        Cascades to Colorado's high country — revealed a gap: no single source combined
        USGS water quality data, OpenStreetMap geographic data, and real access conditions
        into one place. Soak Trail fills that gap.
      </p>
      <p class="text-sa-dark/80 leading-relaxed mt-4">
        Each spring in the Soak Trail network has been researched using multiple
        data sources including:
      </p>
      <ul class="list-disc pl-6 mt-4 space-y-2 text-sa-dark/80">
        <li>USGS NWIS water quality records (temperature, pH, conductivity, mineral content)</li>
        <li>OpenStreetMap Overpass API (trail access, roads, amenities)</li>
        <li>Wikipedia and Wikidata (historical context and articles)</li>
        <li>Open-Meteo elevation data</li>
        <li>Recreation.gov campground search</li>
        <li>NOAA weather forecasts</li>
        <li>Field visits and first-hand verification</li>
      </ul>

      <h2 class="font-display text-2xl font-bold text-sa-dark mt-10 mb-4" id="disclosure">Disclosure</h2>
      <p class="text-sa-dark/80 leading-relaxed">
        Soak Trail may earn affiliate commissions from gear recommendations and
        booking links. This does not affect editorial content or spring ratings.
        All spring data is independently researched and verified. Sponsored content,
        if any, will be clearly labeled.
      </p>
      <p class="text-sa-dark/80 leading-relaxed mt-4">
        Hot springs conditions change. Always verify access, temperature, and fees
        before visiting. Natural hot springs can be dangerous — follow leave-no-trace
        principles and respect private property.
      </p>

      <h2 class="font-display text-2xl font-bold text-sa-dark mt-10 mb-4">Connect</h2>
      <div class="flex gap-4 mt-4">
        <a href="https://www.instagram.com/soaktrail" target="_blank" rel="noopener noreferrer"
          class="text-sa-copper hover:underline">Instagram</a>
        <a href="https://bsky.app/profile/soaktrail.bsky.social" target="_blank" rel="noopener noreferrer"
          class="text-sa-copper hover:underline">Bluesky</a>
        <a href="https://www.pinterest.com/soaktrail" target="_blank" rel="noopener noreferrer"
          class="text-sa-copper hover:underline">Pinterest</a>
      </div>
    </div>
  </div>
</BaseLayout>
