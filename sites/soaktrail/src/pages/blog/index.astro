---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { wolly } from '../../lib/wolly';

const SITE_SLUG = 'soaktrail';
const PAGE_SIZE = 9;

const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);

const allPosts: any[] = [];
try {
  let offset = 0;
  const limit = 50;
  while (true) {
    const result = await wolly.pages.list({ type: 'blog', sort: 'published_at:desc', status: 'published', limit, offset });
    const filtered = result.data.filter((post: any) => post.fields?.site === SITE_SLUG);
    allPosts.push(...filtered);
    const total = result.meta?.total || 0;
    offset += limit;
    if (offset >= total) break;
  }
} catch (e) {
  console.error('Blog: WollyCMS API error:', e);
}

const totalPages = Math.max(1, Math.ceil(allPosts.length / PAGE_SIZE));
const safePage = Math.min(page, totalPages);
const start = (safePage - 1) * PAGE_SIZE;
const posts = allPosts.slice(start, start + PAGE_SIZE);

const pageDescription = 'Latest guides, science, and stories from the hot springs of the American West. Expert advice, regional insights, and road trip inspiration.';

const jsonLd = {
  '@type': 'Blog',
  name: 'Soak Trail Journal',
  url: 'https://soaktrail.com/blog',
  description: pageDescription,
  blogPost: posts.slice(0, 10).map((post) => ({
    '@type': 'BlogPosting',
    headline: post.title,
    url: `https://soaktrail.com/blog/${post.slug}`,
    datePublished: post.meta?.published_at,
    dateModified: post.meta?.updated_at,
    image: post.fields?.featured_image || undefined,
  })),
};
---

<BaseLayout
  title="Journal — Soak Trail"
  description={pageDescription}
  jsonLd={jsonLd}
>
  <main class="max-w-7xl mx-auto px-6 py-16 md:py-24">
    <header class="mb-16 md:mb-20">
      <p class="text-sa-copper text-sm tracking-[0.3em] uppercase mb-4 font-body">The Soak Trail Journal</p>
      <h1 class="font-display text-4xl md:text-6xl font-light text-sa-dark leading-tight">
        Guides, Science &<span class="italic block mt-1"> Hot Spring Wisdom</span>
      </h1>
    </header>

    {posts.length === 0 ? (
      <p class="text-sa-text text-lg">No posts published yet — check back soon.</p>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 h-feed">
        {posts.map((post: any, index: number) => (
          <article class="h-entry group block border border-sa-divider bg-white hover:border-sa-copper transition-colors duration-300 rounded-xl overflow-hidden">
            <a href={`/blog/${post.slug}`} class="block">
              {post.fields?.featured_image && (
                <div class="aspect-video overflow-hidden">
                  <img
                    src={post.fields.featured_image}
                    alt={post.title}
                    class="u-photo w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading={index === 0 ? "eager" : "lazy"}
                    decoding={index === 0 ? "sync" : "async"}
                  />
                </div>
              )}
              <div class="p-6">
                <h2 class="font-display text-xl font-medium text-sa-dark mb-3 group-hover:text-sa-copper transition-colors duration-300 leading-snug p-name">
                  {post.title}
                </h2>
                {post.fields?.excerpt && (
                  <p class="text-sa-text text-sm leading-relaxed line-clamp-3 mb-4 p-summary">{post.fields.excerpt}</p>
                )}
                <div class="flex items-center gap-2 text-sa-copper text-sm font-body font-medium">
                  <span>Read more</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="group-hover:translate-x-1 transition-transform duration-300">
                    <path d="M5 12h14M12 5l7 7-7 7" />
                  </svg>
                </div>
                <time class="dt-published hidden" datetime={post.meta?.published_at}>{post.meta?.published_at}</time>
              </div>
            </a>
          </article>
        ))}
      </div>
    )}

    {totalPages > 1 && (
      <nav class="mt-16 flex justify-center gap-3">
        {safePage > 1 && (
          <a href={`/blog?page=${safePage - 1}`} class="px-5 py-2 border border-sa-divider text-sa-text hover:border-sa-copper hover:text-sa-copper transition-colors duration-300 rounded-full text-sm font-body">
            ← Previous
          </a>
        )}
        <span class="px-5 py-2 text-sa-text text-sm font-body">
          Page {safePage} of {totalPages}
        </span>
        {safePage < totalPages && (
          <a href={`/blog?page=${safePage + 1}`} class="px-5 py-2 border border-sa-divider text-sa-text hover:border-sa-copper hover:text-sa-copper transition-colors duration-300 rounded-full text-sm font-body">
            Next →
          </a>
        )}
      </nav>
    )}
  </main>
</BaseLayout>
