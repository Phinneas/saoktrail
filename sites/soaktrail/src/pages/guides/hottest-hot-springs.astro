---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

export const prerender = true;

const canonical = 'https://soaktrail.com/guides/hottest-hot-springs';
const title = 'The Hottest Hot Springs in the American West | Soak Trail';

// Fetch all springs from the API at build time and sort by temperature
let hotSprings: any[] = [];
let totalCount = 0;
try {
  const res = await fetch('https://soakatlas-mcp.buzzuw2.workers.dev/springs?limit=2000');
  if (res.ok) {
    const data = await res.json();
    const allSprings = (data.springs || []).filter((s: any) => s.temperature_f && s.lat && s.lng);
    totalCount = allSprings.length;
    hotSprings = allSprings
      .sort((a: any, b: any) => (b.temperature_f || 0) - (a.temperature_f || 0))
      .slice(0, 30);
  }
} catch { /* use empty array */ }

const description = ` ranked by water temperature from SoakTrail's database of ${totalCount} springs with verified temperature data.`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://soaktrail.com/' },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://soaktrail.com/guides' },
    { '@type': 'ListItem', position: 3, name: 'Hottest Hot Springs', item: canonical },
  ],
};

const itemListSchema = {
  '@type': 'ItemList',
  name: 'Hottest Hot Springs in the American West',
  description: `Top ${hotSprings.length} hottest natural hot springs ranked by water temperature`,
  numberOfItems: hotSprings.length,
  itemListElement: hotSprings.map((s: any, i: number) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${s.name} — ${s.temperature_f}°F`,
    url: `https://soaktrail.com/locator`,
  })),
};

const REGION_SITES: Record<string, string> = {
  washington: 'https://www.washingtonhotsprings.com',
  alaska: 'https://www.alaskahotsprings.com',
  shasta: 'https://www.shastahotsprings.com',
  colorado: 'https://www.soakcolorado.com',
  rockies: 'https://www.soaktherockies.com',
  desert: 'https://www.desertsoak.com',
};

const REGION_NAMES: Record<string, string> = {
  washington: 'Washington',
  alaska: 'Alaska',
  shasta: 'Northern California & Southern Oregon',
  colorado: 'Colorado & New Mexico',
  rockies: 'Idaho, Montana & Wyoming',
  desert: 'Utah, Nevada & Arizona',
};

function tempColor(temp: number): string {
  if (temp >= 150) return 'text-red-600';
  if (temp >= 110) return 'text-orange-500';
  if (temp >= 95) return 'text-green-600';
  return 'text-blue-500';
}

function tempLabel(temp: number): string {
  if (temp >= 150) return 'Boiling — not safe for soaking';
  if (temp >= 110) return 'Very hot — use caution';
  if (temp >= 95) return 'Soakable range';
  return 'Warm';
}
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonical}
  jsonLd={[breadcrumbSchema, itemListSchema]}
>
  <main class="max-w-5xl mx-auto px-6 py-16 md:py-24">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Guides', href: '/guides' }, { label: 'Hottest Hot Springs' }]} />

    <header class="mb-12">
      <p class="text-sa-copper text-sm tracking-[0.3em] uppercase mb-4 font-body">Data Guide</p>
      <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-light text-sa-dark leading-tight mb-6">
        The Hottest <span class="italic">Hot Springs</span>
      </h1>
      <p class="text-sa-text text-lg leading-relaxed max-w-3xl">
        Every spring in SoakTrail's database, ranked by water temperature. From near-boiling geothermal vents to comfortable soakable pools — here's where the water runs hottest.
      </p>
      <p class="text-sa-text/60 text-sm mt-4">
        {totalCount} springs with verified temperature data · Source: SoakTrail locator database
      </p>
    </header>

    <div class="mb-12 rounded-xl border border-sa-divider bg-sa-copper/5 p-6">
      <p class="text-sa-dark/80 text-sm leading-relaxed">
        <strong>Important:</strong> High temperature does not mean good for soaking. Water above 110°F can cause burns. Water above 150°F is dangerous. The most comfortable soaking range is 95–110°F. Many of the springs below are too hot to enter safely — they're listed here for scientific interest and to show the full range of geothermal activity in the American West.
      </p>
    </div>

    {hotSprings.length > 0 ? (
      <div class="space-y-3">
        {hotSprings.map((spring: any, i: number) => {
          const siteUrl = REGION_SITES[spring.region];
          return (
            <div class="flex items-center gap-4 p-4 rounded-xl bg-white border border-sa-divider hover:border-sa-copper transition-colors">
              <span class="font-mono text-sm text-sa-dark/30 w-8 text-right shrink-0">{i + 1}</span>
              <div class="min-w-0 flex-1">
                <div class="flex items-baseline gap-2">
                  <h3 class="font-display font-bold text-sa-dark truncate">{spring.name}</h3>
                </div>
                <p class="text-xs text-sa-text/60 capitalize">
                  {spring.state} · {REGION_NAMES[spring.region] || spring.region}
                  {spring.access_type ? ` · ${spring.access_type}` : ''}
                </p>
              </div>
              <div class="text-right shrink-0">
                <p class={`font-mono font-bold text-lg ${tempColor(spring.temperature_f)}`}>
                  {spring.temperature_f}°F
                </p>
                <p class="text-xs text-sa-text/50">{tempLabel(spring.temperature_f)}</p>
              </div>
              {siteUrl && (
                <a
                  href={`${siteUrl}/springs/${spring.slug}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sa-copper hover:text-sa-dark text-xs font-medium shrink-0"
                >
                  View →
                </a>
              )}
            </div>
          );
        })}
      </div>
    ) : (
      <div class="text-center py-12 text-sa-text">
        <p>Temperature data is being loaded. Check back soon.</p>
      </div>
    )}

    <div class="mt-16 pt-8 border-t border-sa-divider">
      <h2 class="font-display text-2xl font-bold text-sa-dark mb-4">About This Data</h2>
      <div class="space-y-4 text-sa-text text-sm leading-relaxed">
        <p>
          Temperatures come from USGS water-quality records, published surveys, and field measurements.
          They represent point-in-time readings — natural springs fluctuate seasonally and after seismic events.
        </p>
        <p>
          The SoakTrail database currently tracks {totalCount} springs with verified temperature data across
          the American West. For complete access information, seasonal conditions, and trip-planning details,
          visit the <a href="/locator" class="text-sa-copper hover:underline">full locator map</a>.
        </p>
      </div>
    </div>
  </main>
</BaseLayout>
