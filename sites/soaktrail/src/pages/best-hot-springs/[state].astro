---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AuthorAttribution from '../../components/AuthorAttribution.astro';
import stateSpringsData from '../../data/state_springs.json';

export const prerender = true;

const STATE_NAMES: Record<string, string> = {
  AK: 'Alaska',
  CA: 'California',
  CO: 'Colorado',
  ID: 'Idaho',
  MT: 'Montana',
  OR: 'Oregon',
  WA: 'Washington',
  WY: 'Wyoming',
};

const STATE_COORDS: Record<string, { lat: number; lng: number }> = {
  AK: { lat: 64.2, lng: -152.5 },
  CA: { lat: 36.8, lng: -119.4 },
  CO: { lat: 39.0, lng: -105.5 },
  ID: { lat: 44.4, lng: -114.6 },
  MT: { lat: 47.0, lng: -109.6 },
  OR: { lat: 43.8, lng: -120.6 },
  WA: { lat: 47.4, lng: -120.5 },
  WY: { lat: 43.0, lng: -107.6 },
};

const STATE_REGIONS: Record<string, { name: string; url: string }> = {
  AK: { name: 'Alaska Hot Springs', url: 'https://www.alaskahotsprings.com' },
  CA: { name: 'Shasta Hot Springs', url: 'https://www.shastahotsprings.com' },
  CO: { name: 'Soak Colorado', url: 'https://www.soakcolorado.com' },
  ID: { name: 'Soak the Rockies', url: 'https://www.soaktherockies.com' },
  MT: { name: 'Soak the Rockies', url: 'https://www.soaktherockies.com' },
  OR: { name: 'Shasta Hot Springs', url: 'https://www.shastahotsprings.com' },
  WA: { name: 'Washington Hot Springs', url: 'https://www.washingtonhotsprings.com' },
  WY: { name: 'Soak the Rockies', url: 'https://www.soaktherockies.com' },
};

interface Spring {
  name: string;
  slug: string;
  temp_f: number | null;
  temp_class: string;
  elevation_ft: number | null;
  access_type: string;
  season: string;
  fee: string;
  description: string;
  site_url: string;
  nearest_city: string | null;
  nearest_dist: number | null;
  status: string;
}

type StateData = Record<string, Spring[]>;

const allStates = stateSpringsData as StateData;

export function getStaticPaths() {
  const data = stateSpringsData as StateData;
  return Object.keys(data).map((code) => ({
    params: { state: code.toLowerCase() },
    props: { code },
  }));
}

const { code } = Astro.props as { code: string };
const springs = allStates[code] || [];
const stateName = STATE_NAMES[code] || code;
const region = STATE_REGIONS[code];
const canonical = `https://soaktrail.com/best-hot-springs/${code.toLowerCase()}`;

const soakableSprings = springs.filter((s) => s.temp_class === 'soakable');
const hotSprings = springs.filter((s) => s.temp_class === 'hot' || s.temp_class === 'very_hot');
const yearRound = springs.filter((s) => s.season.toLowerCase().includes('year'));
const hikeIn = springs.filter((s) => s.access_type.toLowerCase().includes('hike'));
const driveUp = springs.filter((s) => {
  const a = s.access_type.toLowerCase();
  return a.includes('drive') || a.includes('paved') || a.includes('roadside') || a.includes('resort');
});

const title = `Best Hot Springs in ${stateName} — ${springs.length} Mapped Springs | Soak Trail`;
const description = `${springs.length} natural hot springs in ${stateName}: ${soakableSprings.length} soakable (95–110°F), ${yearRound.length} year-round. Compare temperature, access, and distance from the nearest city.`;

// Show top springs (soakable first, max 50 for page performance)
const displaySprings = springs.slice(0, 50);

const faqs = [
  {
    q: `How many hot springs are in ${stateName}?`,
    a: `Soak Trail has mapped ${springs.length} natural hot springs in ${stateName}. Of those, ${soakableSprings.length} are in the ideal soaking range of 95–110°F, and ${yearRound.length} are open year-round.`,
  },
  {
    q: `What is the best hot spring in ${stateName}?`,
    a: soakableSprings.length > 0
      ? `The most popular soakable hot spring in ${stateName} is ${soakableSprings[0].name}${soakableSprings[0].temp_f ? ` at ${soakableSprings[0].temp_f}°F` : ''}${soakableSprings[0].nearest_city ? `, located near ${soakableSprings[0].nearest_city}` : ''}. It's accessible via ${soakableSprings[0].access_type.toLowerCase()}.`
      : `Hot springs in ${stateName} tend to run above the ideal soaking temperature. Check individual listings for current conditions and cooling pools.`,
  },
  {
    q: `Are hot springs in ${stateName} free?`,
    a: `Most natural hot springs in ${stateName} on public land are free to visit. Some require a Forest Service day-use pass ($5–$10), and developed resorts charge admission. Each listing on Soak Trail shows the current fee status.`,
  },
  {
    q: `Do I need to hike to reach hot springs in ${stateName}?`,
    a: `${hikeIn.length} of ${springs.length} springs in ${stateName} require a hike. ${driveUp.length} are accessible by standard vehicle (drive-up, paved road, or resort). Check each listing for specific access details and road conditions.`,
  },
  {
    q: `When is the best time to visit hot springs in ${stateName}?`,
    a: yearRound.length > 0
      ? `${yearRound.length} hot springs in ${stateName} are open year-round. Mountain springs at higher elevations are best visited July–September when roads are clear. Winter soaking is popular at lower-elevation and resort springs.`
      : `Check individual spring listings for seasonal access. Mountain springs are typically best visited July–September.`,
  },
];

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};

const itemListSchema = {
  '@type': 'ItemList',
  name: `Best Hot Springs in ${stateName}`,
  description: `${springs.length} natural hot springs in ${stateName}, ranked by soakability and temperature`,
  numberOfItems: Math.min(displaySprings.length, 10),
  itemListElement: displaySprings.slice(0, 10).map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: s.name,
    url: `${s.site_url}/springs/${s.slug}`,
  })),
};

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://soaktrail.com/' },
    { '@type': 'ListItem', position: 2, name: 'Records & Superlatives', item: 'https://soaktrail.com/records' },
    { '@type': 'ListItem', position: 3, name: `Best Hot Springs in ${stateName}`, item: canonical },
  ],
};

const stateCoords = STATE_COORDS[code];
const placeSchema = stateCoords ? {
  '@type': 'Place',
  name: `${stateName} Hot Springs`,
  description: `${springs.length} natural hot springs in ${stateName}, ${soakableSprings.length} soakable (95–110°F)`,
  geo: {
    '@type': 'GeoCoordinates',
    latitude: stateCoords.lat,
    longitude: stateCoords.lng,
  },
  containedInPlace: {
    '@type': 'AdministrativeArea',
    name: stateName,
  },
} : null;

function tempBadge(tempClass: string) {
  switch (tempClass) {
    case 'soakable': return { label: 'Soakable', cls: 'bg-green-100 text-green-800' };
    case 'hot': return { label: 'Hot', cls: 'bg-orange-100 text-orange-800' };
    case 'very_hot': return { label: 'Very Hot', cls: 'bg-red-100 text-red-800' };
    case 'warm': return { label: 'Warm', cls: 'bg-blue-100 text-blue-800' };
    default: return { label: 'Unknown', cls: 'bg-gray-100 text-gray-600' };
  }
}
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonical}
  jsonLd={[breadcrumbSchema, itemListSchema, placeSchema, faqSchema].filter(Boolean)}
>
  <div class="container mx-auto px-4 py-12 max-w-5xl">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Records', href: '/records' },
      { label: `${stateName} Hot Springs` },
    ]} />

    <!-- Header -->
    <header class="mt-8 mb-12">
      <h1 class="font-display text-4xl md:text-5xl font-light text-sa-dark leading-tight mb-4">
        Best Hot Springs
        <span class="italic"> in {stateName}</span>
      </h1>
      <p class="text-lg text-sa-dark/70 max-w-3xl leading-relaxed">
        <strong class="text-sa-dark">Soak Trail maps {springs.length} natural hot springs in {stateName}</strong>
        — {soakableSprings.length} in the ideal soaking range (95–110°F), {yearRound.length} open year-round.
        Data from USGS and OpenStreetMap.
        {region && <> Detailed guides: <a href={region.url} target="_blank" rel="noopener noreferrer" class="text-sa-copper hover:underline">{region.name}</a></>}
      </p>
      <p class="text-sm text-sa-dark/40 mt-2">
        Data from USGS and OpenStreetMap. Last updated: {new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}
      </p>
      <AuthorAttribution class="mt-4" />
    </header>

    <!-- Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
      {[
        { number: String(springs.length), label: 'Total Springs' },
        { number: String(soakableSprings.length), label: 'Soakable (95–110°F)' },
        { number: String(yearRound.length), label: 'Year-Round' },
        { number: String(driveUp.length), label: 'Drive-Up Access' },
      ].map((stat) => (
        <div class="text-center border border-sa-dark/10 rounded-xl bg-white/60 p-5">
          <p class="font-body text-3xl font-light text-sa-copper mb-1">{stat.number}</p>
          <p class="text-sa-dark/50 text-xs tracking-wider uppercase font-body">{stat.label}</p>
        </div>
      ))}
    </div>

    <!-- Comparison Table -->
    <section class="mb-16">
      <h2 class="font-display text-2xl font-light text-sa-dark mb-2">
        All Hot Springs
        <span class="italic"> in {stateName}</span>
      </h2>
      <p class="text-sa-dark/60 mb-6 text-sm">
        Sorted by soakability first (95–110°F), then by temperature. Click any spring name for full details.
      </p>
      <div class="overflow-x-auto border border-sa-dark/10 rounded-xl">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="bg-sa-dark/5 border-b border-sa-dark/10">
              <th class="py-3 px-3 text-xs uppercase tracking-wider text-sa-dark/50 font-body w-8">#</th>
              <th class="py-3 px-3 text-xs uppercase tracking-wider text-sa-dark/50 font-body">Spring</th>
              <th class="py-3 px-3 text-xs uppercase tracking-wider text-sa-dark/50 font-body text-center">Temp</th>
              <th class="py-3 px-3 text-xs uppercase tracking-wider text-sa-dark/50 font-body text-center">Status</th>
              <th class="py-3 px-3 text-xs uppercase tracking-wider text-sa-dark/50 font-body">Access</th>
              <th class="py-3 px-3 text-xs uppercase tracking-wider text-sa-dark/50 font-body">Season</th>
              <th class="py-3 px-3 text-xs uppercase tracking-wider text-sa-dark/50 font-body">Nearest City</th>
              <th class="py-3 px-3 text-xs uppercase tracking-wider text-sa-dark/50 font-body text-right">Dist</th>
            </tr>
          </thead>
          <tbody>
            {displaySprings.map((s, i) => {
              const badge = tempBadge(s.temp_class);
              return (
                <tr class="border-b border-sa-dark/5 hover:bg-sa-copper/5 transition-colors duration-150">
                  <td class="py-2.5 px-3 font-mono text-xs text-sa-dark/40">{i + 1}</td>
                  <td class="py-2.5 px-3">
                    <a
                      href={`${s.site_url}/springs/${s.slug}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-display font-medium text-sa-dark hover:text-sa-copper transition-colors"
                    >
                      {s.name}
                    </a>
                    {s.description && (
                      <p class="text-xs text-sa-dark/40 mt-0.5 line-clamp-1">{s.description}</p>
                    )}
                  </td>
                  <td class="py-2.5 px-3 text-center font-mono text-sa-dark whitespace-nowrap">
                    {s.temp_f ? `${s.temp_f}°F` : '—'}
                  </td>
                  <td class="py-2.5 px-3 text-center">
                    <span class={`inline-block px-2 py-0.5 rounded-full text-xs font-medium ${badge.cls}`}>
                      {badge.label}
                    </span>
                  </td>
                  <td class="py-2.5 px-3 text-sa-dark/60 capitalize text-xs">{s.access_type}</td>
                  <td class="py-2.5 px-3 text-sa-dark/60 text-xs">{s.season || '—'}</td>
                  <td class="py-2.5 px-3 text-sa-dark/60 text-xs">{s.nearest_city || '—'}</td>
                  <td class="py-2.5 px-3 text-right font-mono text-xs text-sa-dark/50">
                    {s.nearest_dist ? `${s.nearest_dist} mi` : '—'}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      {springs.length > 50 && (
        <p class="text-sm text-sa-dark/40 mt-3 text-center">
          Showing top 50 of {springs.length} springs.{' '}
          <a href={region?.url} target="_blank" rel="noopener noreferrer" class="text-sa-copper hover:underline">
            View all on {region?.name} →
          </a>
        </p>
      )}
    </section>

    <!-- Data Source -->
    <section class="mb-12 border border-sa-dark/10 rounded-xl bg-white/60 p-5">
      <p class="text-sa-dark/50 text-sm">
        <strong class="text-sa-dark">Data sources:</strong> USGS National Water Information System,
        OpenStreetMap (ODbL), NOAA Thermal Springs dataset. Spring data verified against field reports where available.
        {region && <> Detailed guides with photos, directions, and insider tips: <a href={region.url} target="_blank" rel="noopener noreferrer" class="text-sa-copper hover:underline">{region.name}</a></>}
      </p>
    </section>

    <!-- FAQ -->
    <section class="mb-16">
      <h2 class="font-display text-2xl font-light text-sa-dark mb-6 text-center">
        Frequently Asked
        <span class="italic"> Questions</span>
      </h2>
      <div class="space-y-4 max-w-3xl mx-auto">
        {faqs.map((faq) => (
          <details class="group border border-sa-dark/10 rounded-xl bg-white/60 overflow-hidden">
            <summary class="flex items-center justify-between gap-4 px-5 py-4 cursor-pointer list-none hover:bg-sa-copper/5 transition-colors duration-200">
              <h3 class="font-display text-base font-medium text-sa-dark pr-4">{faq.q}</h3>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-sa-copper shrink-0 group-open:rotate-180 transition-transform duration-200">
                <path d="M6 9l6 6 6-6" />
              </svg>
            </summary>
            <div class="px-5 pb-4 text-sa-text text-sm leading-relaxed">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- Cross-links -->
    <section class="mb-8">
      <h2 class="font-display text-xl font-bold text-sa-dark mb-4">Explore Other States</h2>
      <div class="flex flex-wrap gap-2">
        {Object.keys(allStates).filter((c) => c !== code).map((c) => (
          <a
            href={`/best-hot-springs/${c.toLowerCase()}`}
            class="inline-block rounded-full border border-sa-dark/10 bg-white/60 px-4 py-2 text-sm text-sa-dark hover:border-sa-copper hover:text-sa-copper transition"
          >
            {STATE_NAMES[c] || c} <span class="text-sa-dark/40">· {allStates[c].length}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <div class="text-center">
      <a href="/locator" class="inline-flex items-center gap-3 bg-sa-dark text-white px-8 py-4 rounded-full hover:bg-sa-copper transition-colors duration-300">
        <span class="text-sm font-body font-medium tracking-wide uppercase">Open the Map</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</BaseLayout>
