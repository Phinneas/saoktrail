---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import { getBlogPost, renderBody } from '../../lib/d1Blog';

export const prerender = false;

const SITE_SLUG = 'soaktrail';
const SLUG = 'hot-spring-chemistry-guide';
const canonical = `https://soaktrail.com/minerals/chemistry-guide`;

const post = await getBlogPost(SLUG, SITE_SLUG);
if (!post) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const bodyHtml = post.body ? renderBody(post.body) : null;
const featuredImage = post.image_url || null;
const publishedAt = post.published_at;
const updatedAt = post.updated_at;
const authorName = post.author || 'Soak Trail';

const pageDescription = post.excerpt
  ? post.excerpt
  : post.body
    ? post.body.replace(/[#*_`]/g, '').slice(0, 155).trim() + (post.body.length > 155 ? '...' : '')
    : `${post.title} — Hot springs guide from Soak Trail.`;

const jsonLd = [
  {
    '@type': 'BlogPosting',
    headline: post.title,
    description: pageDescription,
    url: canonical,
    image: post.image_url || undefined,
    author: {
      '@type': 'Organization',
      name: authorName,
      url: 'https://soaktrail.com',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Soak Trail',
      logo: {
        '@type': 'ImageObject',
        url: 'https://soaktrail.com/hero-hotspring.jpg',
      },
    },
    datePublished: publishedAt,
    dateModified: updatedAt || publishedAt,
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': canonical,
    },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://soaktrail.com/' },
      { '@type': 'ListItem', position: 2, name: 'Minerals', item: 'https://soaktrail.com/minerals' },
      { '@type': 'ListItem', position: 3, name: post.title, item: canonical },
    ],
  },
];
---

<BaseLayout
  title="Hot Spring Chemistry Guide — Soak Trail"
  description={pageDescription}
  ogImage={post.image_url}
  ogType="article"
  canonicalUrl={canonical}
  author={authorName}
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  jsonLd={jsonLd}
>
  <main class="max-w-3xl mx-auto px-6 py-16 md:py-24">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Minerals', href: '/minerals' },
      { label: 'Hot Spring Chemistry Guide' },
    ]} />

    <article class="h-entry">
      <header class="mb-10">
        <h1 class="font-display text-3xl md:text-5xl font-medium text-sa-dark leading-tight mb-6 p-name">
          {post.title}
        </h1>
        <div class="flex items-center gap-4 text-sm text-sa-text">
          <time class="dt-published" datetime={publishedAt}>
            {publishedAt ? new Date(publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : ''}
          </time>
          <span class="text-sa-divider">·</span>
          <span class="p-author h-card">
            <span class="p-name">{authorName}</span>
          </span>
        </div>
      </header>

      {featuredImage && (
        <div class="mb-10 aspect-video rounded-xl overflow-hidden">
          <img
            src={featuredImage}
            alt={post.title}
            fetchpriority="high"
            class="u-photo w-full h-full object-cover"
          />
        </div>
      )}

      {bodyHtml ? (
        <div class="prose prose-lg prose-stone max-w-none blog-content e-content" set:html={bodyHtml} />
      ) : (
        <p class="text-sa-text">Content coming soon.</p>
      )}

      <a class="u-url hidden" href={canonical}>Permalink</a>

      <ShareButtons
        url={canonical}
        title={post.title}
        description={pageDescription}
      />
    </article>

    <div class="mt-16 pt-8 border-t border-sa-divider">
      <a href="/minerals" class="inline-flex items-center gap-2 text-sa-copper hover:text-sa-dark transition-colors duration-300 text-sm font-body font-medium">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5M12 5l-7 7 7 7" />
        </svg>
        Back to Minerals
      </a>
    </div>
  </main>
</BaseLayout>

<style is:global>
  .blog-content h1, .blog-content h2, .blog-content h3 {
    font-family: 'Fraunces', serif;
    color: var(--color-sa-dark, #1a1a1a);
  }
  .blog-content a { color: #b87333; }
  .blog-content a:hover { color: #8b4513; }
</style>
