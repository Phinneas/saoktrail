---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { MINERALS } from '../../lib/minerals';

export const prerender = true;

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://soaktrail.com/' },
    { '@type': 'ListItem', position: 2, name: 'Minerals', item: 'https://soaktrail.com/minerals' },
  ],
};

const properties = MINERALS.filter((m) => m.group === 'property');
const minerals = MINERALS.filter((m) => m.group === 'mineral');

const description =
  'A field guide to the minerals in natural hot springs — pH, TDS, calcium, magnesium, sodium, sulfate, chloride, and iron — with USGS-sourced concentration data and cited, cautious health context.';
---

<BaseLayout
  title="Hot Spring Minerals — Soak Trail"
  description={description}
  canonicalUrl="https://soaktrail.com/minerals"
  jsonLd={breadcrumbSchema}
>
  <div class="container mx-auto px-4 py-12 max-w-5xl">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Minerals', href: '/minerals' }]} />

    <h1 class="font-display text-4xl font-bold text-sa-dark mt-8 mb-4">Hot Spring Minerals</h1>
    <p class="text-lg text-sa-dark/80 leading-relaxed max-w-3xl">
      What is actually in the water you are soaking in. Each profile covers one constituent
      of hot-spring chemistry, ranks U.S. hot springs by its concentration, and explains
      the health context with cited sources. Concentrations come from the
      <a href="https://www.waterqualitydata.us/" target="_blank" rel="noopener noreferrer" class="text-sa-copper hover:underline">USGS Water Quality Portal</a>,
      matched to each spring's USGS monitoring site.
    </p>

    <div class="mt-6 rounded-lg border border-sa-copper/30 bg-sa-copper/5 p-4 text-sm text-sa-dark/70 max-w-3xl">
      <strong class="text-sa-dark">A note on health claims.</strong> Drinking-water guideline
      values (EPA, WHO) apply to <em>ingestion</em>, not dermal soaking. Balneology research is
      mixed in quality and balneotherapy is adjunctive, not a treatment for any condition. We
      keep claims cautious and cite the source for each one.
    </div>

    <a
      href="/minerals/chemistry-guide"
      class="group mt-8 block rounded-xl border border-sa-copper/40 bg-gradient-to-br from-sa-copper/10 to-sa-copper/5 p-8 hover:border-sa-copper hover:shadow-md transition max-w-3xl"
    >
      <div class="flex items-start justify-between gap-4">
        <div class="min-w-0">
          <h2 class="font-display text-2xl font-bold text-sa-dark">Hot Spring Chemistry Guide</h2>
          <p class="text-sa-dark/70 leading-relaxed mt-3">
            A complete guide to the science behind hot spring water — pH, mineral content,
            geothermal chemistry, and what it means for your soak.
          </p>
          <span class="inline-flex items-center gap-2 mt-5 text-sa-copper font-medium group-hover:gap-3 transition-all">
            Read the guide
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </span>
        </div>
        <div class="shrink-0 text-sa-copper/40">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 3h6v4h4v14H5V7h4z" />
            <path d="M9 14h6M9 17h6M9 11h6" />
          </svg>
        </div>
      </div>
    </a>

    <h2 class="font-display text-2xl font-bold text-sa-dark mt-12 mb-4">Water properties</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {properties.map((m) => (
        <a
          href={`/minerals/${m.key}`}
          class="block rounded-lg border border-sa-dark/10 bg-white/60 p-6 hover:border-sa-copper hover:shadow-sm transition"
        >
          <h3 class="font-display text-xl font-bold text-sa-dark">{m.name}</h3>
          <p class="text-sa-copper text-sm font-display mt-1">{m.tagline}</p>
          <p class="text-sa-dark/70 text-sm mt-3 leading-relaxed">{m.whatItIs}</p>
          <span class="inline-block mt-4 text-sm text-sa-copper font-medium">View profile &amp; rankings →</span>
        </a>
      ))}
    </div>

    <h2 class="font-display text-2xl font-bold text-sa-dark mt-12 mb-4">Minerals</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {minerals.map((m) => (
        <a
          href={`/minerals/${m.key}`}
          class="block rounded-lg border border-sa-dark/10 bg-white/60 p-6 hover:border-sa-copper hover:shadow-sm transition"
        >
          <h3 class="font-display text-xl font-bold text-sa-dark">{m.name}</h3>
          <p class="text-sa-copper text-sm font-display mt-1">{m.tagline}</p>
          <p class="text-sa-dark/70 text-sm mt-3 leading-relaxed">{m.whatItIs}</p>
          <span class="inline-block mt-4 text-sm text-sa-copper font-medium">View profile &amp; rankings →</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
