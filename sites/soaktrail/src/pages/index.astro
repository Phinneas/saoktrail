---
import BaseLayout from '../layouts/BaseLayout.astro';
import AskAI from '../components/AskAI.astro';
import AuthorAttribution from '../components/AuthorAttribution.astro';
import HomeMap from '../components/HomeMap.jsx';

const runtimeEnv = ((Astro.locals as any).runtime?.env ?? {}) as Record<string, string | undefined>;
const maptilerKey = runtimeEnv.PUBLIC_MAPTILER_KEY || import.meta.env.PUBLIC_MAPTILER_KEY;
const apiUrl = import.meta.env.PUBLIC_API_URL;

// Fetch live stats from the API at build time
let totalSprings = 515;
let regionCount = 6;
let stateCount = 11;
try {
  const statsRes = await fetch('https://soakatlas-mcp.buzzuw2.workers.dev/stats');
  if (statsRes.ok) {
    const stats = await statsRes.json();
    totalSprings = stats.total_springs || totalSprings;
    regionCount = Object.keys(stats.regions || {}).length || regionCount;
    // Count unique states across regions
    const states = new Set<string>();
    for (const r of Object.values(stats.regions || {}) as any[]) {
      for (const s of (r.states || [])) states.add(s);
    }
    stateCount = states.size || stateCount;
  }
} catch { /* use defaults */ }

const regions = [
  {
    title: 'Washington Hot Springs',
    subtitle: 'Pacific Northwest Soaks',
    description: "From moss-carpeted rainforest pools to Cascade mountain retreats, discover Washington's hidden thermal treasures among ancient evergreens and misty valleys.",
    link: 'https://www.washingtonhotsprings.com',
    image: '/washington-hotspring.jpg',
    location: 'Washington State',
  },
  {
    title: 'Alaska Hot Springs',
    subtitle: 'Last Frontier Thermal Waters',
    description: "From remote wilderness pools accessible only by bush plane to natural seaside soaks along the coast, discover Alaska's rugged geothermal treasures under the northern lights.",
    link: 'https://www.alaskahotsprings.com',
    image: '/alaska-hotspring.jpg',
    location: 'Alaska',
  },
  {
    title: 'Soak Colorado',
    subtitle: 'Rocky Mountain Mineral Waters',
    description: 'Colorado sits atop remarkable geothermal activity with over 30 developed resorts and countless primitive soaking spots scattered throughout the Rockies.',
    link: 'https://www.soakcolorado.com',
    image: '/colorado-hotspring.jpg',
    location: 'Colorado',
  },
  {
    title: 'Shasta Hot Springs',
    subtitle: 'Northern California & Southern Oregon',
    description: 'Sacred waters beneath the shadow of Mount Shasta. Explore volcanic thermal pools, creekside soaking, and healing mineral springs in the spiritual heart of the Cascades.',
    link: 'https://www.shastahotsprings.com',
    image: '/shasta-hotspring.jpg',
    location: 'Mount Shasta Region',
  },
  {
    title: 'Soak the Rockies',
    subtitle: 'Idaho, Montana & Wyoming',
    description: "A geological survey-style directory of the Northern Rockies' best hot springs. Find natural thermal pools with real-time conditions across vast wilderness landscapes.",
    link: 'https://www.soaktherockies.com',
    image: '/rockies-hotspring.jpg',
    location: 'Northern Rockies',
  },
  {
    title: 'Desert Soak',
    subtitle: 'Desert Oasis Thermal Pools',
    description: 'Discover steaming oases tucked between red rock canyons and sagebrush valleys. The Southwest holds hundreds of natural springs in its dramatic desert terrain.',
    link: 'https://www.desertsoak.com',
    image: '/desert-hotspring.jpg',
    location: 'Southwest Desert',
  },
];

const homeDescription = 'Your trusted guide to the American West\'s finest natural hot springs. Explore regional directories for Washington, Alaska, Colorado, Shasta, the Rockies, and the Desert Southwest.';

const faqs = [
  {
    q: 'How many hot springs are in the American West?',
    a: 'Soak Trail maps over 500 natural hot springs across 11 western US states, including Colorado, Idaho, Montana, Wyoming, Washington, Alaska, California, Oregon, Utah, Nevada, and Arizona. The data includes water temperature, mineral content, access type, and nearby camping.',
  },
  {
    q: 'What is the difference between a wild hot spring and a resort hot spring?',
    a: 'Wild (or natural) hot springs are undeveloped pools in natural settings with little or no infrastructure — you might need to hike or drive a dirt road. Resort hot springs are developed properties with maintained pools, changing rooms, and often lodging and spa services. Soak Trail covers both types across all six regions.',
  },
  {
    q: 'How do I find hot springs near me?',
    a: 'Use the "Near Cities" directory on Soak Trail to find hot springs sorted by driving distance from over 100 western US cities. Each listing shows the distance, water temperature, access type, and links to the full spring guide on the regional site.',
  },
  {
    q: 'Are hot springs in the western US free to visit?',
    a: 'Many natural hot springs on public land are free to visit, though some require a day-use fee or Forest Service pass. Developed resorts charge admission. Soak Trail lists the fee status for each spring so you know before you go.',
  },
  {
    q: 'What minerals are found in hot springs water?',
    a: 'Hot springs water commonly contains calcium, magnesium, sulfate, chloride, sodium, and silica. Mineral concentration varies by spring — some have total dissolved solids under 500 mg/L while others exceed 40,000 mg/L. Soak Trail includes water chemistry data where available.',
  },
  {
    q: 'Can I use an AI assistant to search hot springs data?',
    a: `Yes. Soak Trail provides an MCP (Model Context Protocol) server that AI assistants like Claude, ChatGPT, and other MCP-compatible clients can use to search ${totalSprings}+ hot springs by location, state, temperature, access type, and more.`,
  },
];

const jsonLd = [
  {
    '@type': 'Organization',
    name: 'Soak Trail',
    url: 'https://soaktrail.com',
    logo: 'https://soaktrail.com/hero-hotspring.jpg',
    sameAs: [
      'https://www.instagram.com/soaktrail',
      'https://www.pinterest.com/soaktrail',
      'https://bsky.app/profile/soaktrail.bsky.social',
    ],
    description: homeDescription,
  },
  {
    '@type': 'WebSite',
    name: 'Soak Trail',
    url: 'https://soaktrail.com',
    dateModified: new Date().toISOString().slice(0, 10),
    potentialAction: {
      '@type': 'SearchAction',
      target: 'https://soaktrail.com/blog?q={search_term_string}',
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.a,
      },
    })),
  },
];
---

<BaseLayout
  title="Soak Trail — Find Your Perfect Spring"
  description={homeDescription}
  jsonLd={jsonLd}
  transparentNav
>
  <!-- Hero Section -->
  <section class="relative h-screen min-h-[700px] flex items-center justify-center overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center"
      style="background-image: url('/hero-hotspring.jpg');"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/20 to-black/60" />

    <div class="relative z-10 text-center px-6 max-w-4xl mx-auto h-card">
      <img src="/hero-hotspring.jpg" alt="Soak Trail" class="u-photo hidden" />
      <a class="u-url hidden" href="https://soaktrail.com">Soak Trail</a>
      <p class="text-white/80 text-sm md:text-base tracking-[0.3em] uppercase mb-6 font-body p-note">
        Discover the American West
      </p>
      <h1 class="font-display text-5xl md:text-7xl lg:text-8xl font-light text-white leading-[1.1] mb-8 p-name">
        Find Your
        <span class="italic font-light block mt-2">Perfect Soak</span>
      </h1>
      <p class="text-white/80 text-lg md:text-xl max-w-2xl mx-auto leading-relaxed mb-12 font-light">
        From desert oasis pools to alpine thermal retreats, explore the West's most remarkable natural hot springs.
      </p>
      <a
        href="#destinations"
        class="inline-flex items-center gap-3 bg-white/10 backdrop-blur-sm border border-white/30 text-white px-8 py-4 rounded-full hover:bg-white/20 hover:border-white/50 transition-all duration-300 group"
      >
        <span class="text-sm font-body font-medium tracking-wide uppercase">Explore Destinations</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="group-hover:translate-y-1 transition-transform duration-300">
          <path d="M12 5v14M5 12l7 7 7-7" />
        </svg>
      </a>
    </div>

    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" opacity="0.6">
        <path d="M12 5v14M5 12l7 7 7-7" />
      </svg>
    </div>
  </section>

  <!-- Interactive Map Section -->
  <section id="map" class="py-16 md:py-24 px-6 bg-sa-dark">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-sa-copper text-sm tracking-[0.3em] uppercase mb-4 font-display">
          Explore the Map
        </p>
        <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-light text-white leading-tight mb-4">
          Where the Earth
          <span class="italic"> Runs Hot</span>
        </h2>
        <p class="text-white/60 text-lg max-w-2xl mx-auto leading-relaxed">
          Every documented hot spring across the United States. Filter by temperature, access type, and more. Click any pin for details and a link to its region guide.
        </p>
      </div>

      {maptilerKey ? (
        <HomeMap client:only="react" maptilerKey={maptilerKey} apiUrl={apiUrl} />
      ) : (
        <div class="rounded-xl border border-white/10 bg-white/5 p-8 text-center text-white/50 max-w-2xl mx-auto">
          Map requires a MapTiler key. Visit the <a href="/locator" class="text-sa-copper hover:underline">Locator page</a> or check back soon.
        </div>
      )}

      <div class="mt-8 text-center">
        <a
          href="/locator"
          class="inline-flex items-center gap-3 border border-white/30 text-white px-6 py-3 rounded-full hover:bg-white/10 hover:border-white/50 transition-all duration-300 group"
        >
          <span class="text-sm font-body font-medium tracking-wide uppercase">Full Locator Map</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="group-hover:translate-x-1 transition-transform duration-300">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Trip Planner + Route + Journal CTA -->
  <section class="py-16 md:py-24 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Trip Planner CTA -->
        <a
          href="/trip-planner"
          class="group block p-8 md:p-10 rounded-2xl bg-sa-dark text-white hover:opacity-95 transition-opacity relative overflow-hidden"
        >
          <div class="absolute top-0 right-0 w-48 h-48 bg-sa-copper/10 rounded-full -translate-y-1/2 translate-x-1/2" />
          <div class="relative z-10">
            <p class="text-sa-copper text-xs tracking-[0.25em] uppercase mb-4 font-display">Plan Your Trip</p>
            <h2 class="font-display text-2xl mb-3 leading-snug">Trip Planner</h2>
            <p class="text-white/60 text-sm leading-relaxed">
              {totalSprings}+ springs — filter by access, temperature, and more.
            </p>
            <div class="mt-6 inline-flex items-center gap-2 text-sa-copper text-sm font-body font-medium">
              <span>Start Planning</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="group-hover:translate-x-1 transition-transform duration-300">
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </div>
          </div>
        </a>

        <!-- Route Planner CTA -->
        <a
          href="/trip-planner/route"
          class="group block p-8 md:p-10 rounded-2xl bg-gradient-to-br from-sa-copper to-sa-copper-hover text-white hover:opacity-95 transition-opacity relative overflow-hidden"
        >
          <div class="absolute bottom-0 right-0 w-40 h-40 bg-white/5 rounded-full translate-y-1/2 translate-x-1/2" />
          <div class="relative z-10">
            <p class="text-white/70 text-xs tracking-[0.25em] uppercase mb-4 font-display">New</p>
            <h2 class="font-display text-2xl mb-3 leading-snug">Route Planner</h2>
            <p class="text-white/80 text-sm leading-relaxed">
              Enter start + destination — find springs along your drive.
            </p>
            <div class="mt-6 inline-flex items-center gap-2 text-white text-sm font-body font-medium">
              <span>Plan a Route</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="group-hover:translate-x-1 transition-transform duration-300">
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </div>
          </div>
        </a>

        <!-- Journal CTA -->
        <a
          href="/blog"
          class="group block p-8 md:p-10 rounded-2xl bg-gradient-to-br from-sa-copper/10 to-sa-cream border border-sa-divider hover:border-sa-copper transition-colors relative overflow-hidden"
        >
          <div class="absolute bottom-0 left-0 w-32 h-32 bg-sa-copper/5 rounded-full translate-y-1/2 -translate-x-1/2" />
          <div class="relative z-10">
            <p class="text-sa-copper text-xs tracking-[0.25em] uppercase mb-4 font-display">The Journal</p>
            <h2 class="font-display text-2xl text-sa-dark mb-3 leading-snug">Guides & Stories</h2>
            <p class="text-sa-text text-sm leading-relaxed">
              Geology, water chemistry, regional guides, and road trip itineraries.
            </p>
            <div class="mt-6 inline-flex items-center gap-2 text-sa-copper text-sm font-body font-medium">
              <span>Read the Journal</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="group-hover:translate-x-1 transition-transform duration-300">
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Introduction Section -->
  <section class="py-24 md:py-32 px-6">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-sa-copper text-sm tracking-[0.3em] uppercase mb-6 font-body">
        Natural Thermal Waters
      </p>
      <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-light text-sa-dark leading-tight mb-10">
        Earth's Ancient
        <span class="italic"> Healing Gift</span>
      </h2>
      <div class="space-y-6 text-sa-text text-lg leading-relaxed max-w-3xl mx-auto">
        <p>
          <strong class="text-sa-dark">Soak Trail maps {totalSprings}+ natural hot springs across {stateCount} western US states</strong> — from roadside pools in Idaho to backcountry springs in Colorado's Elk Mountains. Each listing includes water temperature, access type, seasonal conditions, and distance from the nearest city.
        </p>
        <p>
          The American West has the highest concentration of thermal springs in the country, driven by the same volcanic and fault-line geology that built the Rockies and the Cascades. These mineral-rich waters — heated deep underground and rising through ancient rock — range from warm creekside soaks to near-boiling geothermal features.
        </p>
      </div>

      <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8">
        {[
          { number: `${totalSprings}+`, label: 'Natural Springs Mapped' },
          { number: `${regionCount}`, label: 'Regional Guides' },
          { number: `${stateCount}`, label: 'States Covered' },
        ].map((stat) => (
          <div class="text-center">
            <p class="font-body text-5xl md:text-6xl font-light text-sa-copper mb-2">{stat.number}</p>
            <p class="text-sa-text text-sm tracking-wider uppercase font-body">{stat.label}</p>
          </div>
        ))}
      </div>

      <div class="mt-12 max-w-2xl mx-auto">
        <AuthorAttribution />
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="max-w-7xl mx-auto px-6">
    <div class="h-px bg-sa-divider" />
  </div>

  <!-- Destinations Section -->
  <section id="destinations" class="py-24 md:py-32 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-20">
        <p class="text-sa-copper text-sm tracking-[0.3em] uppercase mb-6 font-display">
          Regional Guides
        </p>
        <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-light text-sa-dark leading-tight">
          Choose Your
          <span class="italic"> Destination</span>
        </h2>
      </div>

      <div class="space-y-16 md:space-y-24">
        {regions.map((region, index) => (
          <div class={`group grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center`}>
            <!-- Image -->
            <div class={`relative overflow-hidden rounded-2xl ${index % 2 === 1 ? 'lg:order-2' : ''}`}>
              <div class="aspect-[4/3] overflow-hidden">
                <img
                  src={region.image}
                  alt={region.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                  loading="lazy"
                />
              </div>
              <div class="absolute top-6 left-6 bg-white/90 backdrop-blur-sm px-4 py-2 rounded-full">
                <span class="text-xs font-body font-medium text-sa-dark tracking-wide uppercase">
                  {region.location}
                </span>
              </div>
            </div>

            <!-- Content -->
            <div class={`${index % 2 === 1 ? 'lg:order-1 lg:text-right' : ''}`}>
              <p class="text-sa-copper text-xs tracking-[0.25em] uppercase mb-4 font-body">
                {region.subtitle}
              </p>
              <h3 class="font-display text-3xl md:text-4xl font-medium text-sa-dark mb-6">
                {region.title}
              </h3>
              <p class="text-sa-text text-lg leading-relaxed mb-8 max-w-lg">
                {region.description}
              </p>
              <a
                href={region.link}
                target="_blank"
                rel="noopener noreferrer"
                class={`inline-flex items-center gap-3 text-sa-dark hover:text-sa-copper transition-colors duration-300 group/link ${index % 2 === 1 ? 'flex-row-reverse' : ''}`}
              >
                <span class="text-sm font-body font-medium tracking-wide uppercase border-b border-current pb-1">
                  Visit Website
                </span>
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class={`group-hover/link:translate-x-1 transition-transform duration-300 ${index % 2 === 1 ? 'rotate-180 group-hover/link:-translate-x-1' : ''}`}
                >
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="py-24 md:py-32 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <p class="text-sa-copper text-sm tracking-[0.3em] uppercase mb-6 font-display">
            Our Philosophy
          </p>
          <h2 class="font-display text-4xl md:text-5xl font-light text-sa-dark leading-tight mb-8">
            Preserving the Soak
            <span class="italic"> for Generations</span>
          </h2>
          <div class="space-y-5 text-sa-text text-lg leading-relaxed">
            <p>
              Hot springs are fragile ecosystems. The same geothermal forces that create these magical pools can be disrupted by overuse, pollution, and disrespect. We believe in responsible soaking — leaving no trace, respecting local customs, and preserving these natural wonders for future generations.
            </p>
            <p>
              Each of our regional partner sites shares this commitment. They provide accurate, up-to-date information on access conditions, seasonal closures, and local etiquette so you can enjoy these springs responsibly.
            </p>
          </div>
          <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-6">
            {['Leave No Trace', 'Respect Local Customs', 'Check Seasonal Access', 'Support Local Communities'].map((item) => (
              <div class="flex items-center gap-3">
                <div class="w-2 h-2 rounded-full bg-sa-copper flex-shrink-0" />
                <span class="text-sa-text text-sm font-display font-medium">{item}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="relative">
          <div class="aspect-[3/4] rounded-2xl overflow-hidden">
            <img
              src="/hero-hotspring.jpg"
              alt="Natural hot spring pool"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
          <div class="absolute -bottom-8 -left-8 bg-sa-dark text-white p-8 rounded-2xl max-w-xs hidden md:block">
            <p class="font-body text-2xl italic leading-relaxed">
              "The water remembers. Treat it with reverence."
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MCP Section -->
  <section id="mcp" class="py-24 md:py-32 px-6 bg-sa-dark">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-16">
        <p class="text-sa-copper text-sm tracking-[0.3em] uppercase mb-6 font-display">
          For AI Assistants & Developers
        </p>
        <h2 class="font-display text-4xl md:text-5xl font-light text-white leading-tight mb-6">
          Soak Trail MCP Server
        </h2>
        <p class="text-white/60 text-lg max-w-2xl mx-auto leading-relaxed">
          Query {totalSprings}+ hot springs across the American West directly from AI assistants like Claude, ChatGPT, and any MCP-compatible client.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
        <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
          <h3 class="font-display text-xl font-medium text-white mb-4">5 Search Tools</h3>
          <ul class="space-y-2 text-white/70 text-sm font-display">
            <li>Find springs near a location (Haversine distance)</li>
            <li>Search within map bounding box</li>
            <li>Filter by state, access, temperature, dogs, fees</li>
            <li>Get details for a specific spring by slug</li>
            <li>List all springs in a region</li>
          </ul>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
          <h3 class="font-display text-xl font-medium text-white mb-4">Coverage</h3>
          <ul class="space-y-2 text-white/70 text-sm font-display">
            <li><span class="text-sa-copper font-semibold">Desert</span> — AZ, NV, UT (92 springs)</li>
            <li><span class="text-sa-copper font-semibold">Rockies</span> — ID, MT, WY (261 springs)</li>
            <li><span class="text-sa-copper font-semibold">Colorado</span> — CO (37 springs)</li>
            <li><span class="text-sa-copper font-semibold">Shasta</span> — CA, OR (64 springs)</li>
            <li><span class="text-sa-copper font-semibold">Washington</span> — WA (46 springs)</li>
            <li><span class="text-sa-copper font-semibold">Alaska</span> — AK (seeding in progress)</li>
          </ul>
        </div>
      </div>

      <div class="bg-white/5 border border-white/10 rounded-2xl p-6 mb-12">
        <h3 class="font-display text-xl font-medium text-white mb-4">Quick Start</h3>
        <p class="text-white/60 text-sm mb-4 font-display">Add to your MCP client configuration:</p>
        <pre class="bg-black/30 rounded-lg p-4 text-sm text-white/80 overflow-x-auto font-mono"><code>{`{
  "mcpServers": {
    "soakatlas": {
      "url": "https://soakatlas-mcp.buzzuw2.workers.dev/mcp"
    }
  }
}`}</code></pre>
        <p class="text-white/60 text-sm mt-4 font-display">
          Or test with curl:
        </p>
        <pre class="bg-black/30 rounded-lg p-4 text-sm text-white/80 overflow-x-auto font-mono"><code>{`curl -X POST https://soakatlas-mcp.buzzuw2.workers.dev/mcp \\
  -H "Content-Type: application/json" \\
  -d '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2024-11-05","clientInfo":{"name":"test","version":"1.0"}}}'`}</code></pre>
      </div>

      <div class="text-center">
