---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://soaktrail.com/' },
    { '@type': 'ListItem', position: 2, name: 'Contact', item: 'https://soaktrail.com/contact' },
  ],
};
---

<BaseLayout
  title="Contact — Soak Trail"
  description="Get in touch with Soak Trail — report corrections, suggest springs, ask about partnerships, or reach the team."
  jsonLd={breadcrumbSchema}
>
  <div class="container mx-auto px-4 py-12 max-w-3xl">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Contact' }]} />

    <h1 class="font-display text-4xl font-bold text-sa-dark mt-8 mb-4">Contact</h1>
    <p class="text-lg text-sa-dark/80 leading-relaxed max-w-2xl">
      We'd love to hear from you — whether you've found an error, know of a spring we're missing, or want to talk about working together.
    </p>

    <div class="mt-10 space-y-8">
      <!-- Corrections -->
      <div class="rounded-xl border border-sa-dark/10 bg-white/60 p-6">
        <h2 class="font-display text-xl font-bold text-sa-dark mb-2">Report a Correction</h2>
        <p class="text-sa-dark/70 text-sm leading-relaxed mb-4">
          Found wrong temperature, incorrect access info, or a closed spring? Let us know and we'll update the record.
        </p>
        <a
          href="mailto:corrections@soaktrail.com?subject=Spring%20correction%20report"
          class="inline-flex items-center gap-2 text-sa-copper hover:text-sa-dark transition-colors text-sm font-medium"
        >
          corrections@soaktrail.com
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <!-- Suggest a spring -->
      <div class="rounded-xl border border-sa-dark/10 bg-white/60 p-6">
        <h2 class="font-display text-xl font-bold text-sa-dark mb-2">Suggest a Spring</h2>
        <p class="text-sa-dark/70 text-sm leading-relaxed mb-4">
          Know of a natural hot spring we haven't mapped? Send us the name, approximate location, and any details you have — temperature, access, photos.
        </p>
        <a
          href="mailto:suggest@soaktrail.com?subject=Spring%20suggestion"
          class="inline-flex items-center gap-2 text-sa-copper hover:text-sa-dark transition-colors text-sm font-medium"
        >
          suggest@soaktrail.com
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <!-- General -->
      <div class="rounded-xl border border-sa-dark/10 bg-white/60 p-6">
        <h2 class="font-display text-xl font-bold text-sa-dark mb-2">General Inquiries</h2>
        <p class="text-sa-dark/70 text-sm leading-relaxed mb-4">
          Partnerships, press, API access, or anything else — reach out and we'll get back to you.
        </p>
        <a
          href="mailto:hello@soaktrail.com?subject=General%20inquiry"
          class="inline-flex items-center gap-2 text-sa-copper hover:text-sa-dark transition-colors text-sm font-medium"
        >
          hello@soaktrail.com
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <!-- Social -->
      <div class="rounded-xl border border-sa-dark/10 bg-white/60 p-6">
        <h2 class="font-display text-xl font-bold text-sa-dark mb-2">Follow Us</h2>
        <p class="text-sa-dark/70 text-sm leading-relaxed mb-4">
          Stay up to date with new springs, trip reports, and database updates.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="https://www.instagram.com/soaktrail" target="_blank" rel="noopener noreferrer" class="text-sa-copper hover:text-sa-dark transition-colors text-sm font-medium">Instagram</a>
          <a href="https://www.pinterest.com/soaktrail" target="_blank" rel="noopener noreferrer" class="text-sa-copper hover:text-sa-dark transition-colors text-sm font-medium">Pinterest</a>
          <a href="https://bsky.app/profile/soaktrail.bsky.social" target="_blank" rel="noopener noreferrer" class="text-sa-copper hover:text-sa-dark transition-colors text-sm font-medium">Bluesky</a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
