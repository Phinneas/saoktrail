export const prerender = true;

const canonical = 'https://soaktrail.com/hot-springs-safety-guide';
const title = 'Hot Springs Safety Guide | Soak Trail';
const description =
  "How to soak safely in Colorado's hot springs: water temperature limits, bacteria risks, flash flood awareness, altitude, hydration, winter conditions, and Leave No Trace.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How hot do Colorado hot springs actually get?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Source water often emerges between 100°F and 180°F. Developed soaking pools typically run 95–104°F. Never assume a wild pool is comfortable — test it."
      }
    },
    {
      "@type": "Question",
      "name": "Are hot springs safe during pregnancy?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most providers advise avoiding water above ~100°F, particularly in the first trimester. Confirm with your OB/GYN before your trip."
      }
    },
    {
      "@type": "Question",
      "name": "When is flash flood season?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "July through mid-September, driven by afternoon monsoon storms. Morning soaks are the safer bet in summer."
      }
    },
    {
      "@type": "Question",
      "name": "Can kids soak?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes — in cooler pools (under 100°F), with sessions capped around 10–15 minutes, constant supervision, and no dunking or head submersion."
      }
    },
    {
      "@type": "Question",
      "name": "Is the sulfur smell dangerous?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Not in open-air pools — it's naturally occurring minerals. But avoid extended soaking in enclosed, poorly ventilated grottos."
      }
    }
