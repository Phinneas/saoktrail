---
export interface Props {
  items: { label: string; href?: string }[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-6">
  <ol class="flex items-center gap-2 text-sm text-sa-text flex-wrap">
    {items.map((item, index) => (
      <li class="flex items-center gap-2">
        {index > 0 && <span class="text-sa-divider">/</span>}
        {item.href ? (
          <a href={item.href} class="hover:text-sa-copper transition-colors duration-300">
            {item.label}
          </a>
        ) : (
          <span class="text-sa-dark font-medium" aria-current="page">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
