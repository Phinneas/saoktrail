---
interface Props {
  productName: string;
  url: string;
  useCase: string;
  alternatives: string[];
}

const { productName, url, useCase, alternatives } = Astro.props;

const prompt = `How would ${productName} at ${url} help me ${useCase}, and what makes it different from ${alternatives.join(" or ")}? Be honest about who it's best for and where it falls short.`;
const encoded = encodeURIComponent(prompt);

const platforms = [
  { key: "chatgpt", label: "Ask ChatGPT", baseUrl: "https://chatgpt.com/?q=", icon: "💬", hoverBorder: "hover:border-[#10a37f] hover:text-[#10a37f]" },
  { key: "claude", label: "Ask Claude", baseUrl: "https://claude.ai/new?q=", icon: "🧠", hoverBorder: "hover:border-[#d97757] hover:text-[#d97757]" },
  { key: "perplexity", label: "Ask Perplexity", baseUrl: "https://www.perplexity.ai/?q=", icon: "🔍", hoverBorder: "hover:border-[#20808d] hover:text-[#20808d]" },
];
---

<section class="py-16 px-6 bg-sa-dark border-t border-white/5">
  <div class="max-w-2xl mx-auto text-center">
    <h3 class="font-display text-xl md:text-2xl font-light text-white mb-2">
      Not sure yet?
    </h3>
    <p class="text-white/50 text-sm md:text-base mb-8">
      Ask an AI for a second opinion on whether {productName} is right for you.
    </p>

    <div class="flex flex-wrap justify-center gap-3">
      {platforms.map((p) => (
        <a
          href={`${p.baseUrl}${encoded}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${p.label} about ${productName}`}
          class={`inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-white/10 bg-white/5 text-white/80 text-sm font-display font-medium transition-all duration-200 hover:bg-white/10 ${p.hoverBorder} hover:-translate-y-0.5 hover:shadow-lg hover:shadow-black/20`}
        >
          <span class="text-base">{p.icon}</span>
          <span>{p.label}</span>
        </a>
      ))}
    </div>
  </div>
</section>
