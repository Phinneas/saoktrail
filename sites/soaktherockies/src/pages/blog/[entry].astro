---
export const prerender = false;
import EntryLayout from "@components/blog/EntryLayout.astro";
import { getMergedBlogEntries, getMergedBlogEntry } from "@lib/mergedBlog";
import { siteConfig } from "@site/config";
import similerItems from "@lib/similarItems";

const { entry: slug } = Astro.params;
if (!slug) return Astro.redirect("/blog");

const api = (Astro.locals.runtime as any).env.API as {
  fetch: (url: string, init?: RequestInit) => Promise<Response>;
};
const siteSlug = siteConfig.wollySiteSlug;

const resolved = await getMergedBlogEntry(api, siteSlug, slug);
if (!resolved) return Astro.redirect("/blog");

const allEntries = await getMergedBlogEntries(api, siteSlug);
const relatedEntries = similerItems(resolved.entry, allEntries, resolved.entry.id);
const { entry, Content, headings } = resolved;
---

<EntryLayout entry={entry} relatedEntries={relatedEntries} Content={Content} headings={headings} />
