---
import { getEntries } from "@lib/contentParser";
import { sortByDate } from "@lib/sortFunctions";
import taxonomyFilter from "@lib/taxonomyFilter";
import TaxonLayout from "@components/blog/TaxonLayout.astro";
import type { BlogEntry } from "@/types";

export async function getStaticPaths() {
  const entries = (await getEntries("blog", sortByDate)) as BlogEntry[];
  const tags = [...new Set(entries.flatMap((e) => e.data.tags || []))];
  return tags.map((tag) => ({
    params: { tag },
  }));
}

const { tag } = Astro.params;

const entries = (await getEntries("blog", sortByDate)) as BlogEntry[];
const filteredEntries = taxonomyFilter(entries, "tags", tag);
---

<TaxonLayout taxon={tag} entries={filteredEntries} />
