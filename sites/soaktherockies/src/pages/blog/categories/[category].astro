---
import { getMergedBlogEntries, taxaFromEntries } from "@lib/mergedBlog";
import taxonomyFilter from "@lib/taxonomyFilter";
import TaxonLayout from "@components/blog/TaxonLayout.astro";
import { siteConfig } from "@site/config";

export async function getStaticPaths() {
  const entries = await getMergedBlogEntries(undefined, siteConfig.siteSlug);
  const categories = taxaFromEntries(entries, "categories");
  return categories.map(category => ({ params: { category } }));
}

const { category } = Astro.params;
if (!category) return Astro.redirect("/blog");

const entries = await getMergedBlogEntries(undefined, siteConfig.siteSlug);
const filteredEntries = taxonomyFilter(entries, "categories", category);
---

<TaxonLayout taxon={category} entries={filteredEntries} />
