---
import BaseLayout from "@components/base/BaseLayout.astro";
import Breadcrumbs from "@components/common/Breadcrumbs.astro";
import { stateName } from "@lib/states";
import { siteConfig } from "@site/config";
import cityIndex from "../../data/cities_index.json";

export const prerender = true;

interface IndexEntry {
  city: string;
  state: string;
  region: string | null;
  population: number;
  count: number;
}

const entries = Object.entries(cityIndex) as [string, IndexEntry][];

const byState: Record<string, [string, IndexEntry][]> = {};
for (const [slug, c] of entries) {
  (byState[c.state] ??= []).push([slug, c]);
}
const stateGroups = Object.entries(byState)
  .map(([state, cities]) => ({
    state,
    name: stateName(state),
    cities: cities.sort((a, b) => b[1].population - a[1].population),
    total: cities.length,
    springs: cities.reduce((n, [, c]) => n + c.count, 0),
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

const totalTowns = entries.length;
const totalSprings = entries.reduce((n, [, c]) => n + c.count, 0);

const statesCovered = [...new Set(entries.map(([, c]) => stateName(c.state)))].sort();
const statesLabel = statesCovered.length === 1
  ? statesCovered[0]
  : `${statesCovered.slice(0, -1).join(", ")} & ${statesCovered[statesCovered.length - 1]}`;

const description = `Hot springs near ${totalTowns.toLocaleString()} towns in ${statesLabel} — sorted by driving distance, with temperatures and access notes.`;

const webPageSchema = {
  "@type": "WebPage",
  name: `Hot Springs Near You — Town Guides | ${siteConfig.name}`,
  url: `${siteConfig.url}/near`,
  dateModified: new Date().toISOString().slice(0, 10),
};
---

<BaseLayout title={`Hot Springs Near You — Town Guides | ${siteConfig.name}`} description={description} canonical={`${siteConfig.url}/near`} jsonLd={[webPageSchema]}>
  <section class="section">
    <div class="container">
      <Breadcrumbs />

      <h1 class="h1 mb-3">Hot Springs Near {totalTowns.toLocaleString()} Towns</h1>
      <p class="text-txt-s dark:text-darkmode-txt-s leading-relaxed max-w-3xl">
        Every town in {statesLabel} with a documented hot spring within 50 miles. Pick your town to see nearby springs sorted by distance, with temperatures, access notes, and a link to plan a trip.
      </p>

      <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-3xl">
        <div class="glass p-5 text-center">
          <p class="font-display text-3xl font-bold text-accent">{totalTowns.toLocaleString()}</p>
          <p class="text-sm text-txt-s dark:text-darkmode-txt-s mt-1">town guides</p>
        </div>
        <div class="glass p-5 text-center">
          <p class="font-display text-3xl font-bold text-accent">{stateGroups.length}</p>
          <p class="text-sm text-txt-s dark:text-darkmode-txt-s mt-1">states covered</p>
        </div>
        <div class="glass p-5 text-center">
          <p class="font-display text-3xl font-bold text-accent">{totalSprings.toLocaleString()}</p>
          <p class="text-sm text-txt-s dark:text-darkmode-txt-s mt-1">spring listings</p>
        </div>
      </div>

      <div class="mt-12 space-y-10">
        {stateGroups.map((g) => (
          <section>
            <div class="flex items-baseline justify-between mb-4 border-b border-border dark:border-darkmode-border pb-2">
              <h2 class="font-display text-2xl font-bold text-txt-p dark:text-darkmode-txt-p">{g.name}</h2>
              <p class="text-sm text-txt-s dark:text-darkmode-txt-s">{g.total} towns · {g.springs} spring listings</p>
            </div>
            <div class="flex flex-wrap gap-2">
              {g.cities.map(([slug, c]) => (
                <a href={`/near/${slug}`} class="glass rounded-full px-4 py-2 text-sm text-txt-p dark:text-darkmode-txt-p hover:text-accent transition">
                  {c.city} <span class="text-txt-light dark:text-darkmode-txt-light">· {c.count}</span>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
