---
import CollectionLayout from "@components/blog/CollectionLayout.astro";
import { sortByDate } from "@lib/sortFunctions";
import { getMergedBlogEntries, taxaFromEntries, taxaMultisetFromEntries } from "@lib/mergedBlog";
import { getIndex } from "@lib/contentParser";
import { siteConfig } from "@site/config";

export async function getStaticPaths() {
  const entries = await getMergedBlogEntries(undefined, siteConfig.siteSlug, sortByDate);
  const pageCount = Math.ceil(entries.length / 4);
  const paths = [];
  for (let i = 1; i < pageCount; i++) {
    paths.push({ params: { slug: (i + 1).toString() } });
  }
  return paths;
}

const { slug } = Astro.params;
const currentPageIndex = slug && !isNaN(Number(slug)) ? Number(slug) : 1;

const entries = await getMergedBlogEntries(undefined, siteConfig.siteSlug, sortByDate);

let entryIndex: any;
try {
  entryIndex = await getIndex("blog");
} catch {
  entryIndex = undefined;
}
if (!entryIndex) {
  entryIndex = { id: "-index", collection: "blog", data: { title: "Blog", description: "Washington hot springs blog" }, body: "" };
}

const allCategories = taxaMultisetFromEntries(entries, "categories");
const categories = taxaFromEntries(entries, "categories");
const tags = taxaFromEntries(entries, "tags");

const entriesPerPage = 4;
const indexOfLastEntry = currentPageIndex * entriesPerPage;
const indexOfFirstEntry = indexOfLastEntry - entriesPerPage;
const currentEntries = entries.slice(indexOfFirstEntry, indexOfLastEntry);
const pageCount: number = Math.ceil(entries.length / entriesPerPage);
const noindex = currentPageIndex > 1;
---

<CollectionLayout
  entryIndex={entryIndex}
  entries={currentEntries}
  categories={categories}
  tags={tags}
  allCategories={allCategories}
  pageIndex={currentPageIndex}
  pageCount={pageCount}
  noindex={noindex}
/>
