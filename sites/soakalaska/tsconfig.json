{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "target": "es2022",
    "allowJs": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "jsx": "react",
    "isolatedModules": true,
    "incremental": true,
    "allowSyntheticDefaultImports": true,
    "types": ["@astrojs/client"],
    "paths": {
      "@site/config": ["./site.config.ts"],
      "@assets/*": ["./src/assets/*"],
      "@components/*": ["../../packages/shared/src/components/*"],
      "@helpers/*": ["../../packages/shared/src/components/helpers/*"],
      "@lib/*": ["../../packages/shared/src/lib/*"],
      "@shortcodes/*": ["../../packages/shared/src/components/common/shortcodes/*"],
      "@types/*": ["../../packages/shared/src/types/*"],
      "@/*": ["../../packages/shared/src/*"]
    }
  },
  "include": ["**/*.ts","**/*.tsx","**/*.astro","../../packages/shared/src/**/*.ts","../../packages/shared/src/**/*.tsx","../../packages/shared/src/**/*.astro"],
  "exclude": ["node_modules","dist"]
}
