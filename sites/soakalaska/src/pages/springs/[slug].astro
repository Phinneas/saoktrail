---
import BaseLayout from "@components/base/BaseLayout.astro";
import Breadcrumbs from "@components/common/Breadcrumbs.astro";
import SchemaScript from "@components/schema/SchemaScript.astro";
import { buildBreadcrumbSchema, buildPlaceSchema } from "@lib/schema";
import { mapboxAccessToken } from "@/config/map";
import SpringMapScript from "@components/SpringMapScript.astro";
import ConditionReports from "@components/ConditionReports.tsx";
import springsData from "../../../public/springs.json";

export const prerender = true;

export function getStaticPaths() {
  return springsData.map((spring: any) => ({
    params: { slug: spring.slug },
    props: { spring },
  }));
}

const { spring } = Astro.props;
const slug = spring.slug;

const pageDescription = spring.description
  ? `${spring.description.slice(0, 155)}${spring.description.length > 155 ? "..." : ""}`
  : `${spring.name} — ${spring.temp_f ? spring.temp_f + "°F " : ""}${spring.access_type || ""} hot spring in ${spring.state}.`;

const breadcrumbSchema = buildBreadcrumbSchema([
  { label: "Home", href: "/" },
  { label: "Directory", href: "/directory" },
  { label: spring.name, href: `/springs/${slug}` },
]);

const placeSchema = buildPlaceSchema(spring);

const apiUrl = import.meta.env.PUBLIC_API_URL;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

// Find related springs (same state, excluding current)
const relatedSprings = springsData
  .filter((s: any) => s.state === spring.state && s.slug !== slug)
  .slice(0, 4);
---

<BaseLayout
  title={`${spring.name} — Alaska Hot Springs`}
  description={pageDescription}
  image={spring.image_url}
>
  <Fragment slot="head">
    <SchemaScript schema={breadcrumbSchema} />
    <SchemaScript schema={placeSchema} />
  </Fragment>

  <section class="section">
    <div class="container">
      <Breadcrumbs />

      <h1 class="h1 mb-6 intersect:animate-fadeUp opacity-0">
        {spring.name}
        {spring.status && spring.status !== 'open' && (
          <span class:list={[
            'ml-3 inline-block align-middle rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wider',
            spring.status === 'destroyed' && 'bg-red-100 text-red-700',
            spring.status === 'closed' && 'bg-red-100 text-red-700',
            spring.status === 'seasonal' && 'bg-amber-100 text-amber-700',
          ]}>
            {spring.status}
          </span>
        )}
      </h1>

      {spring.status === 'destroyed' && (
        <div class="mb-6 rounded-lg border-2 border-red-300 bg-red-50 p-4 dark:border-red-800 dark:bg-red-950">
          <p class="font-bold text-red-700 dark:text-red-400">Warning: Site Condemned</p>
          <p class="text-sm text-red-600 dark:text-red-500 mt-1">
            This site has been officially condemned. Do not enter or stay in any buildings. The soaking pool may still be accessible but enter at your own risk. No services are available.
          </p>
        </div>
      )}

      {spring.status === 'closed' && (
        <div class="mb-6 rounded-lg border-2 border-amber-300 bg-amber-50 p-4 dark:border-amber-800 dark:bg-amber-950">
          <p class="font-bold text-amber-700 dark:text-amber-400">Temporarily Closed</p>
          <p class="text-sm text-amber-600 dark:text-amber-500 mt-1">
            This site is currently closed. Check back for updates or report conditions if you have recent information.
          </p>
        </div>
      )}

      {spring.is_soakable === 0 && spring.status !== 'destroyed' && (
        <div class="mb-6 rounded-lg border-2 border-orange-300 bg-orange-50 p-4 dark:border-orange-800 dark:bg-orange-950">
          <p class="font-bold text-orange-700 dark:text-orange-400">Not Safe for Soaking</p>
          <p class="text-sm text-orange-600 dark:text-orange-500 mt-1">
            The water at this spring is dangerously hot and not suitable for soaking without significant cooling. Exercise extreme caution.
          </p>
        </div>
      )}

      {spring.image_url && (
        <div class="mb-6 rounded-lg overflow-hidden intersect:animate-fadeUp opacity-0">
          <img
            src={spring.image_url}
            alt={`${spring.name} hot spring in ${spring.state}`}
            class="w-full h-auto object-cover max-h-[500px]"
            fetchpriority="high"
          />
        </div>
      )}

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12">
        <!-- Main content -->
        <div class="lg:col-span-2">
          <div class="glass p-6 mb-6 intersect:animate-fadeUp opacity-0">
            <h2 class="h3 mb-4">Details</h2>
            <div class="grid grid-cols-2 gap-4 text-sm">
              {spring.temp_f && (
                <div>
                  <span class="text-txt-light dark:text-darkmode-txt-light uppercase tracking-wider text-xs">Temperature</span>
                  <p class="font-mono text-lg font-bold text-txt-p dark:text-darkmode-txt-p">{spring.temp_f}°F</p>
                </div>
              )}
              {spring.elevation_ft && (
                <div>
                  <span class="text-txt-light dark:text-darkmode-txt-light uppercase tracking-wider text-xs">Elevation</span>
                  <p class="font-mono text-txt-p dark:text-darkmode-txt-p">{spring.elevation_ft.toLocaleString()} ft</p>
                </div>
              )}
              <div>
                <span class="text-txt-light dark:text-darkmode-txt-light uppercase tracking-wider text-xs">Coordinates</span>
                <p class="font-mono text-txt-p dark:text-darkmode-txt-p">{spring.lat.toFixed(4)}, {spring.lng.toFixed(4)}</p>
              </div>
              {spring.access_type && (
                <div>
                  <span class="text-txt-light dark:text-darkmode-txt-light uppercase tracking-wider text-xs">Access</span>
                  <p class="capitalize text-txt-p dark:text-darkmode-txt-p">{spring.access_type}</p>
                </div>
              )}
              {spring.development && (
                <div>
                  <span class="text-txt-light dark:text-darkmode-txt-light uppercase tracking-wider text-xs">Development</span>
                  <p class="capitalize text-txt-p dark:text-darkmode-txt-p">{spring.development}</p>
                </div>
              )}
              {spring.season && (
                <div>
                  <span class="text-txt-light dark:text-darkmode-txt-light uppercase tracking-wider text-xs">Season</span>
                  <p class="capitalize text-txt-p dark:text-darkmode-txt-p">{spring.season}</p>
                </div>
              )}
              {spring.fee !== undefined && (
                <div>
                  <span class="text-txt-light dark:text-darkmode-txt-light uppercase tracking-wider text-xs">Fee</span>
                  <p class="text-txt-p dark:text-darkmode-txt-p">{spring.fee === 0 ? "Free" : `$${spring.fee}`}</p>
                </div>
              )}
              {spring.clothing && (
                <div>
                  <span class="text-txt-light dark:text-darkmode-txt-light uppercase tracking-wider text-xs">Clothing</span>
                  <p class="capitalize text-txt-p dark:text-darkmode-txt-p">{spring.clothing}</p>
                </div>
              )}
              {spring.soaking_temp_f && (
                <div>
                  <span class="text-txt-light dark:text-darkmode-txt-light uppercase tracking-wider text-xs">Soaking Temp</span>
                  <p class="font-mono text-lg font-bold text-txt-p dark:text-darkmode-txt-p">{spring.soaking_temp_f}°F</p>
                </div>
              )}
              {spring.road_type && (
                <div>
                  <span class="text-txt-light dark:text-darkmode-txt-light uppercase tracking-wider text-xs">Road Type</span>
                  <p class="capitalize text-txt-p dark:text-darkmode-txt-p">{spring.road_type}</p>
                </div>
              )}
              {spring.last_verified && (
                <div>
                  <span class="text-txt-light dark:text-darkmode-txt-light uppercase tracking-wider text-xs">Last Verified</span>
                  <p class="text-txt-p dark:text-darkmode-txt-p">{new Date(spring.last_verified + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</p>
                </div>
              )}
            </div>
          </div>

          {spring.description && (
            <div class="glass p-6 mb-6 intersect:animate-fadeUp opacity-0">
              <h2 class="h3 mb-4">About</h2>
              <p class="text-txt-s dark:text-darkmode-txt-s leading-relaxed">{spring.description}</p>
            </div>
          )}
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-1">
          <div class="glass p-6 mb-6 intersect:animate-fadeUp opacity-0">
            <h3 class="h4 mb-4">Quick Links</h3>
            <div class="space-y-3">
              <a
                href={`https://www.google.com/maps/dir/?api=1&destination=${spring.lat},${spring.lng}`}
                target="_blank"
                rel="noopener noreferrer"
                class="block w-full py-3 text-center glass-t border border-border dark:border-darkmode-border rounded font-display font-bold text-txt-p dark:text-darkmode-txt-p hover:bg-accent hover:text-white transition-colors"
              >
                Get Directions
              </a>
              <a
                href={`https://www.google.com/maps/@${spring.lat},${spring.lng},14z`}
                target="_blank"
                rel="noopener noreferrer"
                class="block w-full py-3 text-center glass-t border border-border dark:border-darkmode-border rounded font-display font-bold text-txt-p dark:text-darkmode-txt-p hover:bg-accent hover:text-white transition-colors"
              >
                View on Google Maps
              </a>
              <a
                href={`https://www.recreation.gov/search?latitude=${spring.lat}&longitude=${spring.lng}&radius=20&inventory_type=camping`}
                target="_blank"
                rel="noopener noreferrer"
                class="block w-full py-3 text-center glass-t border border-border dark:border-darkmode-border rounded font-display font-bold text-txt-p dark:text-darkmode-txt-p hover:bg-accent hover:text-white transition-colors"
              >
                Find Campgrounds on Recreation.gov
              </a>
            </div>
          </div>

          {spring.cell_coverage && (
            <div class="glass p-6 mb-6 intersect:animate-fadeUp opacity-0">
              <h3 class="h4 mb-2">Cell Coverage</h3>
              <p class="text-sm text-txt-s dark:text-darkmode-txt-s capitalize">{spring.cell_coverage}</p>
            </div>
          )}

          {spring.dog_policy && (
            <div class="glass p-6 mb-6 intersect:animate-fadeUp opacity-0">
              <h3 class="h4 mb-2">Dog Policy</h3>
              <p class="text-sm text-txt-s dark:text-darkmode-txt-s">{spring.dog_policy}</p>
            </div>
          )}

          {spring.ada_accessible && (
            <div class="glass p-6 mb-6 intersect:animate-fadeUp opacity-0">
              <h3 class="h4 mb-2">Accessibility</h3>
              <p class="text-sm text-txt-s dark:text-darkmode-txt-s">ADA Accessible</p>
            </div>
          )}

          {spring.wikipedia_url && (
            <div class="glass p-6 mb-6 intersect:animate-fadeUp opacity-0">
              <h3 class="h4 mb-2">Learn More</h3>
              {spring.wikipedia_summary && (
                <p class="text-sm text-txt-s dark:text-darkmode-txt-s mb-3">{spring.wikipedia_summary}</p>
              )}
              <a
                href={spring.wikipedia_url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm font-display font-bold text-accent hover:underline"
              >
                Read on Wikipedia →
              </a>
            </div>
          )}

          {spring.usgs?.water_quality?.length > 0 && (
            <div class="glass p-6 mb-6 intersect:animate-fadeUp opacity-0">
              <h3 class="h4 mb-2">USGS Water Quality</h3>
              <p class="text-xs text-txt-light dark:text-darkmode-txt-light mb-3">
                Nearest site: {spring.usgs.site_name} ({spring.usgs.distance_miles} mi)
              </p>
              <div class="space-y-2">
                {spring.usgs.water_quality.map((wq: any) => (
                  <div class="flex justify-between text-sm">
                    <span class="text-txt-s dark:text-darkmode-txt-s">{wq.parameter}</span>
                    <span class="font-mono text-txt-p dark:text-darkmode-txt-p">{wq.value} {wq.unit}</span>
                  </div>
                ))}
              </div>
              <a
                href={spring.usgs.usgs_url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-display font-bold text-accent hover:underline mt-3 block"
              >
                USGS Site {spring.usgs.site_no} →
              </a>
            </div>
          )}

          {spring.osm && (
            <div class="glass p-6 mb-6 intersect:animate-fadeUp opacity-0">
              <h3 class="h4 mb-2">OpenStreetMap Data</h3>
              <p class="text-xs text-txt-light dark:text-darkmode-txt-light mb-3">
                OSM: {spring.osm.osm_name} ({spring.osm.match_distance_miles} mi)
              </p>
              {spring.osm.nearby.trails.length > 0 && (
                <div class="mb-3">
                  <p class="text-xs font-bold uppercase tracking-wider text-txt-light dark:text-darkmode-txt-light mb-1">Trails</p>
                  {spring.osm.nearby.trails.map((t: any) => (
                    <p class="text-sm text-txt-s dark:text-darkmode-txt-s">
                      {t.name || t.type}{t.surface ? ` (${t.surface})` : ''}
                    </p>
                  ))}
                </div>
              )}
              {spring.osm.nearby.access_roads.length > 0 && (
                <div class="mb-3">
                  <p class="text-xs font-bold uppercase tracking-wider text-txt-light dark:text-darkmode-txt-light mb-1">Access Roads</p>
                  {spring.osm.nearby.access_roads.map((r: any) => (
                    <p class="text-sm text-txt-s dark:text-darkmode-txt-s">
                      {r.name || r.type}{r.surface ? ` — ${r.surface}` : ''}
                    </p>
                  ))}
                </div>
              )}
              {spring.osm.nearby.parking.length > 0 && (
                <div class="mb-3">
                  <p class="text-xs font-bold uppercase tracking-wider text-txt-light dark:text-darkmode-txt-light mb-1">Parking</p>
                  {spring.osm.nearby.parking.map((p: any) => (
                    <p class="text-sm text-txt-s dark:text-darkmode-txt-s">
                      {p.name || 'Parking'}{p.capacity ? ` — ${p.capacity} spaces` : ''}
                    </p>
                  ))}
                </div>
              )}
              {spring.osm.nearby.amenities.length > 0 && (
                <div class="mb-3">
                  <p class="text-xs font-bold uppercase tracking-wider text-txt-light dark:text-darkmode-txt-light mb-1">Nearby Amenities</p>
                  {spring.osm.nearby.amenities.map((a: any) => (
                    <p class="text-sm text-txt-s dark:text-darkmode-txt-s">{a.name || a.type}</p>
                  ))}
                </div>
              )}
              <a
                href={spring.osm.osm_url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-display font-bold text-accent hover:underline mt-2 block"
              >
                View on OpenStreetMap →
              </a>
            </div>
          )}
        </div>
      </div>

      <!-- Map -->
      <div class="glass p-6 mb-12">
        <h2 class="h3 mb-4">Location</h2>
        <div id="spring-map" class="h-[400px] rounded-lg overflow-hidden" data-lat={spring.lat} data-lng={spring.lng} data-name={spring.name} data-token={mapboxAccessToken}>
        </div>
      </div>

      {apiUrl && (
        <div class="intersect:animate-fadeUp opacity-0 mb-12">
          <ConditionReports
            client:only="react"
            springSlug={slug}
            apiUrl={apiUrl}
            turnstileSiteKey={turnstileSiteKey}
            site="alaskahotsprings"
          />
        </div>
      )}

      <!-- Related springs -->
      {relatedSprings.length > 0 && (
        <div class="intersect:animate-fadeUp opacity-0">
          <h2 class="h2 mb-6">More Springs in {spring.state}</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            {relatedSprings.map((related: any) => (
              <a
                href={`/springs/${related.slug}`}
                class="glass p-4 hover:scale-[1.02] transition-transform"
              >
                <h3 class="font-display font-bold text-txt-p dark:text-darkmode-txt-p text-sm">{related.name}</h3>
                {related.temp_f && (
                  <p class="text-xs font-mono text-accent mt-1">{related.temp_f}°F</p>
                )}
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<SpringMapScript />
