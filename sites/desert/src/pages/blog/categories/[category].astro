---
export const prerender = false;
import { getMergedBlogEntries } from "@lib/mergedBlog";
import taxonomyFilter from "@lib/taxonomyFilter";
import TaxonLayout from "@components/blog/TaxonLayout.astro";
import { siteConfig } from "@site/config";

const { category } = Astro.params;
if (!category) return Astro.redirect("/blog");

const api = (Astro.locals.runtime as any).env.API as {
  fetch: (url: string, init?: RequestInit) => Promise<Response>;
};
const entries = await getMergedBlogEntries(api, siteConfig.wollySiteSlug);
const filteredEntries = taxonomyFilter(entries, "categories", category);
---

<TaxonLayout taxon={category} entries={filteredEntries} />
