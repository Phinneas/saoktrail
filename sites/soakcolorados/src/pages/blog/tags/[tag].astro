---
import { getMergedBlogEntries } from "@lib/mergedBlog";
import taxonomyFilter from "@lib/taxonomyFilter";
import TaxonLayout from "@components/blog/TaxonLayout.astro";
import { siteConfig } from "@site/config";

export async function getStaticPaths() {
  const entries = await getMergedBlogEntries(undefined, siteConfig.siteSlug);
  const tags = [...new Set(entries.flatMap((e) => e.data?.tags || []))];
  return tags.map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;
if (!tag) return Astro.redirect("/blog");

const entries = await getMergedBlogEntries(undefined, siteConfig.siteSlug);
const filteredEntries = taxonomyFilter(entries, "tags", tag);
---

<TaxonLayout taxon={tag} entries={filteredEntries} />
