---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { wolly } from '../../lib/wolly';

const SITE_SLUG = 'soaktrail';
const PAGE_SIZE = 9;

const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);

const allPosts: any[] = [];
let offset = 0;
const limit = 50;
while (true) {
  const result = await wolly.pages.list({ type: 'blog', sort: 'published_at:desc', status: 'published', limit, offset });
  const filtered = result.data.filter((post: any) => post.fields?.site === SITE_SLUG);
  allPosts.push(...filtered);
  const total = result.meta?.total || 0;
  offset += limit;
  if (offset >= total) break;
}

const totalPages = Math.max(1, Math.ceil(allPosts.length / PAGE_SIZE));
const safePage = Math.min(page, totalPages);
const start = (safePage - 1) * PAGE_SIZE;
const posts = allPosts.slice(start, start + PAGE_SIZE);
---

<BaseLayout title="Blog — Soak Trail">
  <nav class="sticky top-0 z-50 bg-sa-cream/95 backdrop-blur-md shadow-sm py-4">
    <div class="max-w-7xl mx-auto px-6 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-9 h-9 rounded-full bg-sa-copper flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2c0 4-4 8-4 14 0 2.2 1.8 4 4 4s4-1.8 4-4c0-6-4-10-4-14z"/>
            <path d="M9 21h6"/>
          </svg>
        </div>
        <span class="font-body text-xl font-semibold tracking-tight text-sa-dark">Soak Trail</span>
      </a>
      <div class="flex items-center gap-6">
        <a href="/#destinations" class="text-sm font-body font-medium tracking-wide uppercase text-sa-text hover:text-sa-copper transition-colors duration-300">Destinations</a>
        <a href="/blog" class="text-sm font-body font-medium tracking-wide uppercase text-sa-copper">Journal</a>
      </div>
    </div>
  </nav>

  <main class="max-w-7xl mx-auto px-6 py-16 md:py-24">
    <header class="mb-16 md:mb-20">
      <p class="text-sa-copper text-sm tracking-[0.3em] uppercase mb-4 font-body">The Soak Trail Journal</p>
      <h1 class="font-display text-4xl md:text-6xl font-light text-sa-dark leading-tight">
        Guides, Science &<span class="italic block mt-1"> Hot Spring Wisdom</span>
      </h1>
    </header>

    {posts.length === 0 ? (
      <p class="text-sa-text text-lg">No posts published yet — check back soon.</p>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post: any) => (
          <a href={`/blog/${post.slug}`} class="group block border border-sa-divider bg-white hover:border-sa-copper transition-colors duration-300 rounded-xl overflow-hidden">
            {post.fields?.featured_image && (
              <div class="aspect-video overflow-hidden">
                <img
                  src={post.fields.featured_image}
                  alt={post.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </div>
            )}
            <div class="p-6">
              <h2 class="font-display text-xl font-medium text-sa-dark mb-3 group-hover:text-sa-copper transition-colors duration-300 leading-snug">
                {post.title}
              </h2>
              {post.fields?.excerpt && (
                <p class="text-sa-text text-sm leading-relaxed line-clamp-3 mb-4">{post.fields.excerpt}</p>
              )}
              <div class="flex items-center gap-2 text-sa-copper text-sm font-body font-medium">
                <span>Read more</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="group-hover:translate-x-1 transition-transform duration-300">
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    )}

    {totalPages > 1 && (
      <nav class="mt-16 flex justify-center gap-3">
        {safePage > 1 && (
          <a href={`/blog?page=${safePage - 1}`} class="px-5 py-2 border border-sa-divider text-sa-text hover:border-sa-copper hover:text-sa-copper transition-colors duration-300 rounded-full text-sm font-body">
            ← Previous
          </a>
        )}
        <span class="px-5 py-2 text-sa-text text-sm font-body">
          Page {safePage} of {totalPages}
        </span>
        {safePage < totalPages && (
          <a href={`/blog?page=${safePage + 1}`} class="px-5 py-2 border border-sa-divider text-sa-text hover:border-sa-copper hover:text-sa-copper transition-colors duration-300 rounded-full text-sm font-body">
            Next →
          </a>
        )}
      </nav>
    )}
  </main>
</BaseLayout>
