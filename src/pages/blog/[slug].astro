---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import { wolly } from '../../lib/wolly';
import { marked } from 'marked';

const SITE_SLUG = 'soaktrail';

const { slug } = Astro.params;

let page: any;

try {
  page = await wolly.pages.getBySlug(slug as string);
  if (page.fields?.site !== SITE_SLUG) {
    return new Response(null, { status: 404, statusText: 'Not Found' });
  }
} catch {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

// WollyCMS collapses newlines to double-spaces when saving plain text fields.
function restoreMarkdown(text: string): string {
  return text
    .replace(/  (#{1,6} )/g, '\n\n$1')
    .replace(/  /g, '\n\n')
    .replace(/\n{3,}/g, '\n\n')
    .trim();
}

const rawBody = (typeof page.fields?.body === 'string' && page.fields.body)
  ? page.fields.body
  : null;

const bodyHtml = rawBody ? await marked(restoreMarkdown(rawBody)) : null;
const featuredImage = page.fields?.featured_image || null;
const publishedAt = page.meta?.published_at || page.meta?.updated_at;
const updatedAt = page.meta?.updated_at;
const authorName = page.fields?.author || 'Soak Trail';

const pageDescription = page.fields?.excerpt
  ? page.fields.excerpt
  : rawBody
    ? rawBody.replace(/[#*_`]/g, '').slice(0, 155).trim() + (rawBody.length > 155 ? '...' : '')
    : `${page.title} — Hot springs guide from Soak Trail.`;

const jsonLd = [
  {
    '@type': 'BlogPosting',
    headline: page.title,
    description: pageDescription,
    url: `https://soaktrail.com/blog/${slug}`,
    image: page.fields?.featured_image || undefined,
    author: {
      '@type': 'Organization',
      name: authorName,
      url: 'https://soaktrail.com',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Soak Trail',
      logo: {
        '@type': 'ImageObject',
        url: 'https://soaktrail.com/hero-hotspring.jpg',
      },
    },
    datePublished: publishedAt,
    dateModified: updatedAt || publishedAt,
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': `https://soaktrail.com/blog/${slug}`,
    },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://soaktrail.com/' },
      { '@type': 'ListItem', position: 2, name: 'Journal', item: 'https://soaktrail.com/blog' },
      { '@type': 'ListItem', position: 3, name: page.title },
    ],
  },
];
---

<BaseLayout
  title={`${page.title} — Soak Trail Journal`}
  description={pageDescription}
  ogImage={page.fields?.featured_image}
  ogType="article"
  author={authorName}
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  jsonLd={jsonLd}
>
  <nav class="sticky top-0 z-50 bg-sa-cream/95 backdrop-blur-md shadow-sm py-4">
    <div class="max-w-7xl mx-auto px-6 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-9 h-9 rounded-full bg-sa-copper flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2c0 4-4 8-4 14 0 2.2 1.8 4 4 4s4-1.8 4-4c0-6-4-10-4-14z"/>
            <path d="M9 21h6"/>
          </svg>
        </div>
        <span class="font-body text-xl font-semibold tracking-tight text-sa-dark">Soak Trail</span>
      </a>
      <div class="flex items-center gap-6">
        <a href="/#destinations" class="text-sm font-body font-medium tracking-wide uppercase text-sa-text hover:text-sa-copper transition-colors duration-300">Destinations</a>
        <a href="/blog" class="text-sm font-body font-medium tracking-wide uppercase text-sa-text hover:text-sa-copper transition-colors duration-300">Journal</a>
      </div>
    </div>
  </nav>

  <main class="max-w-3xl mx-auto px-6 py-16 md:py-24">
    <Breadcrumbs items={[
      { label: 'Home', href: '/' },
      { label: 'Journal', href: '/blog' },
      { label: page.title },
    ]} />

    <article class="h-entry">
      <header class="mb-10">
        <h1 class="font-display text-3xl md:text-5xl font-medium text-sa-dark leading-tight mb-6 p-name">
          {page.title}
        </h1>
        <div class="flex items-center gap-4 text-sm text-sa-text">
          <time class="dt-published" datetime={publishedAt}>
            {publishedAt ? new Date(publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : ''}
          </time>
          <span class="p-author h-card hidden">
            <a class="u-url" href="https://soaktrail.com" rel="author">
              <span class="p-name">{authorName}</span>
            </a>
          </span>
        </div>
      </header>

      {featuredImage && (
        <div class="mb-10 aspect-video rounded-xl overflow-hidden">
          <img
            src={featuredImage}
            alt={page.title}
            fetchpriority="high"
            class="u-photo w-full h-full object-cover"
          />
        </div>
      )}

      {bodyHtml ? (
        <div class="prose prose-lg prose-stone max-w-none blog-content e-content" set:html={bodyHtml} />
      ) : (
        <p class="text-sa-text">Content coming soon.</p>
      )}

      {page.fields?.featured_springs && page.fields.featured_springs.length > 0 && (
        <div class="mt-12 pt-8 border-t border-sa-divider">
          <h2 class="text-xl font-bold text-sa-dark mb-4">Featured Springs</h2>
          <div class="flex flex-wrap gap-3">
            {page.fields.featured_springs.map((springSlug: string) => (
              <span class="px-4 py-2 bg-sa-cream text-sa-dark text-sm font-medium rounded-lg border border-sa-divider">
                {springSlug.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase())}
              </span>
            ))}
          </div>
        </div>
      )}

      <a class="u-url hidden" href={`https://soaktrail.com/blog/${slug}`}>Permalink</a>

      <ShareButtons
        url={`https://soaktrail.com/blog/${slug}`}
        title={page.title}
        description={pageDescription}
      />
    </article>

    <div class="mt-16 pt-8 border-t border-sa-divider">
      <a href="/blog" class="inline-flex items-center gap-2 text-sa-copper hover:text-sa-dark transition-colors duration-300 text-sm font-body font-medium">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5M12 5l-7 7 7 7" />
        </svg>
        More from the Journal
      </a>
    </div>
  </main>
</BaseLayout>

<style is:global>
  .blog-content h1, .blog-content h2, .blog-content h3 {
    font-family: 'Fraunces', serif;
    color: var(--color-sa-dark, #1a1a1a);
  }
  .blog-content a { color: #b87333; }
  .blog-content a:hover { color: #8b4513; }
</style>
