{
  "name": "soaktherockies-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create soaktherockies-db",
    "d1:migrations:apply": "wrangler d1 migrations apply soaktherockies-db --remote",
    "d1:migrations:apply:local": "wrangler d1 migrations apply soaktherockies-db --local",
    "blogs:generate": "node scripts/generate-blogs-cli.js",
    "blogs:import": "node --loader ts-node/esm scripts/import-blogs.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@graphql-tools/schema": "^10.0.0",
    "@hono/graphql-server": "^0.7.0",
    "graphql": "^16.9.0",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.6.6",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "pg": "^8.13.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.0",
    "wrangler": "^4.86.0"
  }
}
