---
// Embeddable static preview card for a spring poster.
// Used in the soaktrail.com content sites as a CTA widget.
// Usage: <iframe src="https://shop.soaktrail.com/embed/strawberry-hot-springs" />

const { slug } = Astro.params;
if (!slug) return new Response('Not found', { status: 404 });

const env = Astro.locals.runtime.env;

let spring: { name: string; lat: number; lng: number; state: string } | null = null;
try {
  const res = await fetch(`${env.SOAKATLAS_MCP_URL}/spring/${slug}`);
  if (res.ok) spring = await res.json();
} catch {}

if (!spring) return new Response('Spring not found', { status: 404 });

// Use pre-generated static preview from R2 if available
const previewUrl = `${env.R2_PUBLIC_URL}/previews/${slug}.png`;
const studioUrl  = `https://shop.soaktrail.com/studio/${slug}`;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{spring.name} — SoakTrail Poster</title>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Outfit', sans-serif;
      background: #0f1923;
      color: #f0ebe0;
      height: 100vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .preview {
      flex: 1;
      position: relative;
      overflow: hidden;
    }
    .preview img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .preview-fallback {
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, #1a3a2a 0%, #0a1628 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 48px;
    }
    .footer {
      background: #111d2b;
      padding: 14px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-top: 1px solid #1e3a5f;
      flex-shrink: 0;
    }
    .spring-info { line-height: 1.3; }
    .spring-name { font-size: 15px; font-weight: 600; }
    .spring-state { font-size: 12px; color: #64748b; letter-spacing: 0.05em; text-transform: uppercase; }
    .cta {
      background: #e85d04;
      color: #fff;
      padding: 9px 18px;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .cta:hover { background: #c44d03; }
  </style>
</head>
<body>
  <div class="preview">
    <img
      src={previewUrl}
      alt={`Map preview of ${spring.name}`}
      onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
    />
    <div class="preview-fallback" style="display:none">🌋</div>
  </div>
  <div class="footer">
    <div class="spring-info">
      <div class="spring-name">{spring.name}</div>
      <div class="spring-state">{spring.state}</div>
    </div>
    <a class="cta" href={studioUrl} target="_blank" rel="noopener">
      Create Poster →
    </a>
  </div>
</body>
</html>
