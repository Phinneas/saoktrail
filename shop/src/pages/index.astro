---
const env = Astro.locals.runtime.env;

// Fetch a default set of springs to show on load
let featured: { name: string; slug: string; state: string; region: string }[] = [];
try {
  const res = await fetch(`${env.SOAKATLAS_MCP_URL}/springs?limit=24`);
  if (res.ok) {
    const data = await res.json() as { springs: typeof featured };
    featured = data.springs;
  }
} catch (e) {
  console.error('Failed to fetch springs:', e);
}

const regions = [
  { id: 'alaska', label: 'Alaska Hot Springs', states: 'Alaska' },
  { id: 'rockies', label: 'Soak the Rockies', states: 'Idaho, Montana, Wyoming' },
  { id: 'colorado', label: 'Soak Colorado', states: 'Colorado & New Mexico' },
  { id: 'shasta', label: 'Shasta Hot Springs', states: 'Northern California & Southern Oregon' },
  { id: 'washington', label: 'Washington Hot Springs', states: 'Washington' },
  { id: 'desert', label: 'Desert Soak', states: 'Utah, Nevada, Arizona' },
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SoakTrail Posters — Custom Topo Map Prints of Hot Springs</title>
  <meta name="description" content="Custom topographic map posters of your favorite hot springs. Digital downloads and premium print-on-demand." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Outfit', sans-serif;
      background: #0f1923;
      color: #f0ebe0;
      min-height: 100vh;
    }

    /* Hero */
    .hero {
      text-align: center;
      padding: 80px 24px 40px;
      background: radial-gradient(ellipse at top, #1a3a2a 0%, #0f1923 60%);
    }
    .hero h1 {
      font-size: clamp(32px, 5vw, 52px);
      font-weight: 700;
      letter-spacing: -0.02em;
      margin-bottom: 16px;
      color: #f0ebe0;
    }
    .hero p {
      font-size: 18px;
      color: #94a3b8;
      max-width: 560px;
      margin: 0 auto 32px;
      line-height: 1.6;
    }

    /* Search */
    .search-bar {
      max-width: 520px;
      margin: 0 auto;
      position: relative;
    }
    .search-bar input {
      width: 100%;
      padding: 16px 20px 16px 48px;
      font-size: 16px;
      font-family: 'Outfit', sans-serif;
      background: #111d2b;
      border: 1px solid #1e3a5f;
      border-radius: 12px;
      color: #f0ebe0;
      outline: none;
      transition: border-color 0.2s;
    }
    .search-bar input::placeholder { color: #475569; }
    .search-bar input:focus { border-color: #e85d04; }
    .search-bar svg {
      position: absolute;
      left: 16px;
      top: 50%;
      transform: translateY(-50%);
      width: 20px;
      height: 20px;
      color: #475569;
    }

    /* Region filters */
    .regions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      justify-content: center;
      max-width: 680px;
      margin: 20px auto 0;
    }
    .regions button {
      padding: 10px 18px;
      font-size: 13px;
      font-family: 'Outfit', sans-serif;
      font-weight: 600;
      background: transparent;
      border: 1px solid #1e3a5f;
      border-radius: 12px;
      color: #94a3b8;
      cursor: pointer;
      transition: all 0.2s;
      text-align: left;
      line-height: 1.4;
    }
    .regions button:hover { border-color: #e85d04; color: #f0ebe0; }
    .regions button.active { background: #e85d04; border-color: #e85d04; color: #fff; }
    .regions button .region-name { display: block; font-weight: 600; }
    .regions button .region-states { display: block; font-size: 11px; font-weight: 400; opacity: 0.7; }

    /* Results */
    .results {
      max-width: 960px;
      margin: 0 auto;
      padding: 48px 24px 80px;
    }
    .results-header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      margin-bottom: 24px;
    }
    .results-header h2 { font-size: 22px; font-weight: 600; }
    .results-header .count { color: #475569; font-size: 14px; }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 16px;
    }
    .card {
      display: block;
      padding: 20px;
      background: #111d2b;
      border: 1px solid #1e3a5f;
      border-radius: 12px;
      text-decoration: none;
      color: inherit;
      transition: all 0.2s;
    }
    .card:hover {
      border-color: #e85d04;
      transform: translateY(-2px);
    }
    .card-name { font-size: 16px; font-weight: 600; margin-bottom: 4px; }
    .card-meta { font-size: 12px; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em; }
    .card-cta {
      margin-top: 12px;
      font-size: 13px;
      font-weight: 600;
      color: #e85d04;
    }

    .empty {
      text-align: center;
      padding: 60px 24px;
      color: #475569;
    }
    .loading {
      text-align: center;
      padding: 40px;
      color: #475569;
    }

    /* Footer */
    .footer {
      text-align: center;
      padding: 24px;
      border-top: 1px solid #1e3a5f;
      color: #475569;
      font-size: 13px;
    }
    .footer a { color: #64748b; text-decoration: none; }
    .footer a:hover { color: #f0ebe0; }
  </style>
</head>
<body>
  <section class="hero">
    <h1>SoakTrail Posters</h1>
    <p>Custom topographic map posters of your favorite hot springs. Choose a spring, pick your style, and get a museum-quality print or instant digital download.</p>
    <div class="search-bar">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
      </svg>
      <input
        type="text"
        id="search-input"
        placeholder="Search 500+ hot springs by name..."
        autocomplete="off"
      />
    </div>
    <div class="regions" id="region-filters">
      {regions.map(r => (
        <button data-region={r.id}>
          <span class="region-name">{r.label}</span>
          <span class="region-states">{r.states}</span>
        </button>
      ))}
    </div>
  </section>

  <section class="results">
    <div class="results-header">
      <h2 id="results-title">Featured Springs</h2>
      <span class="count" id="results-count">{featured.length} springs</span>
    </div>
    <div class="grid" id="results-grid">
      {featured.map(s => (
        <a class="card" href={`/studio/${s.slug}`}>
          <div class="card-name">{s.name}</div>
          <div class="card-meta">{s.state} · {s.region}</div>
          <div class="card-cta">Create Poster &rarr;</div>
        </a>
      ))}
    </div>
    <div class="empty" id="empty-state" style="display:none">
      No springs found. Try a different search.
    </div>
    <div class="loading" id="loading-state" style="display:none">Searching...</div>
  </section>

  <footer class="footer">
    <p>SoakTrail Posters &middot; <a href="https://soaktrail.com">soaktrail.com</a></p>
    <p style="margin-top:8px">Built by <a href="https://www.salishseaconsulting.com" target="_blank" rel="noopener">Salish Sea Consulting</a></p>
  </footer>

  <script is:inline define:vars={{ mcpUrl: env.SOAKATLAS_MCP_URL }}>
    const input = document.getElementById('search-input');
    const grid = document.getElementById('results-grid');
    const empty = document.getElementById('empty-state');
    const loading = document.getElementById('loading-state');
    const title = document.getElementById('results-title');
    const count = document.getElementById('results-count');
    const regionButtons = document.querySelectorAll('#region-filters button');
    let activeRegion = '';
    let debounceTimer;

    function render(springs) {
      loading.style.display = 'none';
      count.textContent = `${springs.length} spring${springs.length === 1 ? '' : 's'}`;
      if (springs.length === 0) {
        grid.innerHTML = '';
        empty.style.display = 'block';
        return;
      }
      empty.style.display = 'none';
      grid.innerHTML = springs.map(s => `
        <a class="card" href="/studio/${s.slug}">
          <div class="card-name">${s.name}</div>
          <div class="card-meta">${s.state} &middot; ${s.region}</div>
          <div class="card-cta">Create Poster &rarr;</div>
        </a>
      `).join('');
    }

    async function search() {
      const q = input.value.trim();
      const params = new URLSearchParams();
      if (q) params.set('q', q);
      if (activeRegion) params.set('region', activeRegion);
      params.set('limit', '48');

      loading.style.display = 'block';
      empty.style.display = 'none';

      try {
        const res = await fetch(`${mcpUrl}/springs?${params}`);
        if (!res.ok) throw new Error('Search failed');
        const data = await res.json();
        title.textContent = q || activeRegion ? 'Search Results' : 'Featured Springs';
        render(data.springs);
      } catch (e) {
        loading.style.display = 'none';
        grid.innerHTML = '';
        empty.style.display = 'block';
        empty.textContent = 'Something went wrong. Please try again.';
      }
    }

    input.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(search, 300);
    });

    regionButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const region = btn.dataset.region;
        if (activeRegion === region) {
          activeRegion = '';
          btn.classList.remove('active');
        } else {
          activeRegion = region;
          regionButtons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
        }
        search();
      });
    });
  </script>
</body>
</html>
