---
// shop.soaktrail.com/studio/strawberry-hot-springs
// Loads spring data from soakatlas MCP, renders the PosterStudio component

import PosterStudio from '../../components/PosterStudio.svelte';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/');

const env = Astro.locals.runtime.env;

// Fetch spring from soakatlas MCP Worker
let spring: { name: string; lat: number; lng: number; state: string; slug: string } | null = null;
try {
  const res = await fetch(
    `${env.SOAKATLAS_MCP_URL}/spring/${slug}`,
    { headers: { 'Accept': 'application/json' } }
  );
  if (res.ok) {
    spring = await res.json();
  }
} catch (e) {
  console.error('Failed to fetch spring:', e);
}

if (!spring) {
  return new Response('Spring not found', { status: 404 });
}

const cancelled = Astro.url.searchParams.get('cancelled') === 'true';
const stripePublishableKey = env.STRIPE_PUBLISHABLE_KEY;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{spring.name} Poster — SoakTrail</title>
  <meta name="description" content={`Create a commemorative map poster for ${spring.name}, ${spring.state}`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Outfit', sans-serif; background: #0f1923; color: #f0ebe0; min-height: 100vh; }
  </style>
</head>
<body>
  {cancelled && (
    <div style="background:#7f1d1d;color:#fca5a5;padding:12px 24px;text-align:center;font-size:14px">
      Your order was cancelled — no charge was made. Your poster design is still here.
    </div>
  )}

  <PosterStudio
    client:load
    spring={spring}
    stripePublishableKey={stripePublishableKey}
  />
</body>
</html>
