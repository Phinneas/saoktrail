---
// Polls /api/verify-session until order is ready, then shows download or confirmation

const sessionId = Astro.url.searchParams.get('session_id');
if (!sessionId) return Astro.redirect('/');
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Order Complete — SoakTrail</title>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Outfit', sans-serif;
      background: #0f1923;
      color: #f0ebe0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }
    .card {
      max-width: 520px;
      width: 100%;
      background: #1a2535;
      border-radius: 16px;
      padding: 48px 40px;
      text-align: center;
    }
    .icon { font-size: 56px; margin-bottom: 24px; }
    h1 { font-size: 28px; font-weight: 600; margin-bottom: 12px; }
    .sub { color: #94a3b8; font-size: 16px; line-height: 1.6; margin-bottom: 32px; }
    .btn {
      display: inline-block;
      background: #e85d04;
      color: white;
      padding: 14px 32px;
      border-radius: 8px;
      font-size: 16px;
      font-weight: 600;
      text-decoration: none;
      margin-top: 8px;
    }
    .btn:hover { background: #c44d03; }
    .spinner {
      width: 40px; height: 40px;
      border: 3px solid #334155;
      border-top-color: #e85d04;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin: 0 auto 24px;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    #status-text { color: #94a3b8; font-size: 15px; margin-bottom: 16px; }
  </style>
</head>
<body>
  <div class="card" id="card">
    <div class="spinner" id="spinner"></div>
    <p id="status-text">Processing your order…</p>
  </div>

  <script define:vars={{ sessionId }}>
    let attempts = 0;
    const MAX_ATTEMPTS = 30; // 30 × 3s = 90 seconds max

    async function poll() {
      try {
        const res = await fetch(`/api/verify-session?session_id=${sessionId}`);
        const data = await res.json();

        if (data.status === 'complete' && data.orderType === 'digital' && data.downloadUrl) {
          showDigitalReady(data.downloadUrl);
          return;
        }

        if (data.status === 'gelato_submitted') {
          showPrintConfirmed();
          return;
        }

        if (data.status === 'failed') {
          showError();
          return;
        }

        // Still processing — retry
        attempts++;
        if (attempts < MAX_ATTEMPTS) {
          setTimeout(poll, 3000);
        } else {
          showTimeout();
        }
      } catch {
        attempts++;
        if (attempts < MAX_ATTEMPTS) setTimeout(poll, 3000);
        else showError();
      }
    }

    function showDigitalReady(downloadUrl) {
      document.getElementById('card').innerHTML = `
        <div class="icon">🗺️</div>
        <h1>Your poster is ready!</h1>
        <p class="sub">Your high-res PNG is ready to download. The link is valid for 7 days.</p>
        <a class="btn" href="${downloadUrl}" download>Download Poster</a>
        <p style="margin-top:24px;font-size:13px;color:#64748b">
          A copy has also been sent to your email.
        </p>
      `;
    }

    function showPrintConfirmed() {
      document.getElementById('card').innerHTML = `
        <div class="icon">📦</div>
        <h1>Order confirmed!</h1>
        <p class="sub">
          Your framed print has been submitted to production.
          You'll receive a shipping confirmation by email within 3–5 business days.
        </p>
        <a class="btn" href="/">Browse more springs</a>
      `;
    }

    function showError() {
      document.getElementById('card').innerHTML = `
        <div class="icon">⚠️</div>
        <h1>Something went wrong</h1>
        <p class="sub">
          Your payment was received but we hit an issue with your order.
          Please email <a href="mailto:hello@soaktrail.com" style="color:#e85d04">hello@soaktrail.com</a>
          with your order details and we'll sort it out.
        </p>
      `;
    }

    function showTimeout() {
      document.getElementById('card').innerHTML = `
        <div class="icon">⏳</div>
        <h1>Still processing…</h1>
        <p class="sub">
          Your order is taking longer than expected. Check your email —
          we'll send a link as soon as your poster is ready.
        </p>
        <a class="btn" href="/">Back to home</a>
      `;
    }

    poll();
  </script>
</body>
</html>
