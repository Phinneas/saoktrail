{
  "version": 8,
  "name": "SoakTrail Topo",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "minzoom": 0,
      "maxzoom": 14
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#f5f0e8" }
    },
    {
      "id": "landuse-park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["in", "class", "park", "forest", "meadow", "national_park", "nature_reserve", "wood"],
      "paint": { "fill-color": "#c8d6af", "fill-opacity": 0.75 }
    },
    {
      "id": "landuse-grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["in", "class", "grass", "agriculture"],
      "paint": { "fill-color": "#dce8c0", "fill-opacity": 0.5 }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": { "fill-color": "#a8d0e6" }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#a8d0e6",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 12, 2]
      }
    },
    {
      "id": "road-track",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "track", "path"],
      "paint": {
        "line-color": "#c9b99a",
        "line-width": 0.5,
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service", "tertiary"],
      "paint": {
        "line-color": "#d4c4a0",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 12, 1.5]
      }
    },
    {
      "id": "road-major",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "primary", "secondary", "trunk", "motorway"],
      "paint": {
        "line-color": "#c4ae85",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1, 12, 3]
      }
    }
  ]
}
