{
  "version": 8,
  "name": "SoakTrail Midnight",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "minzoom": 0,
      "maxzoom": 14
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#0a1628" }
    },
    {
      "id": "landuse-park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["in", "class", "park", "forest", "meadow", "national_park", "nature_reserve", "wood"],
      "paint": { "fill-color": "#0d2218", "fill-opacity": 0.9 }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": { "fill-color": "#1e3a5f" }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#1e3a5f",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 12, 2]
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service", "tertiary", "track", "path"],
      "paint": {
        "line-color": "#1a2840",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.3, 12, 1]
      }
    },
    {
      "id": "road-major",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "primary", "secondary", "trunk", "motorway"],
      "paint": {
        "line-color": "#d4af37",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.8, 12, 2.5],
        "line-opacity": 0.6
      }
    }
  ]
}
