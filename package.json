{
  "name": "saoktrail",
  "private": true,
  "workspaces": [
    "packages/*",
    "sites/*"
  ],
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.62.2"
  },
  "scripts": {
    "build": "npm --prefix shop run build",
    "build:shared": "echo 'shared package has no build step (source-only)'",
    "dev:shop": "npm --prefix shop run dev",
    "dev:soakcolorados": "npm run dev --workspace sites/soakcolorados",
    "dev:wa_hot": "npm run dev --workspace sites/wa_hot"
  }
}
